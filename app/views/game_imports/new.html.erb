<h1>Import game data</h1>
<p>Import a JSON export from this catalog, or a CSV of owned copies with a canonical game_id column. Imports add records; they preserve existing notes, ratings, and ownership. Maximum file size: 1 MB.</p>
<%= form_with url: preview_game_import_path, multipart: true, class: 'standard-form' do |f| %>
  <%= f.label :file, 'Game data file' %><%= f.file_field :file, required: true, accept: '.json,.csv' %>
  <%= f.label :format %><%= f.select :format, [['JSON', 'json'], ['CSV copies', 'csv']] %>
  <%= f.submit 'Validate and preview', class: 'btn btn-primary' %>
<% end %>
