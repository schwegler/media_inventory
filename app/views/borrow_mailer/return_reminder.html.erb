<div style="background-color: #0b0f19; font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #f8fafc; margin: 0; padding: 40px 20px; min-height: 100vh; box-sizing: border-box;">
  <div style="max-width: 560px; margin: 0 auto; background-color: #1a2035; border-radius: 12px; border: 1px solid #2e374a; padding: 32px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);">
    <div style="text-align: center; margin-bottom: 28px; padding-bottom: 20px; border-bottom: 1px solid #2e374a;">
      <h1 style="color: #06b6d4; font-size: 28px; font-weight: 700; margin: 0; letter-spacing: -0.5px;">Trove</h1>
    </div>

    <% if @overdue %>
      <div style="background-color: rgba(239, 68, 68, 0.1); border-left: 4px solid #ef4444; border-radius: 6px; padding: 16px; margin-bottom: 24px;">
        <h2 style="color: #ef4444; font-size: 20px; font-weight: 700; margin: 0 0 8px 0;">Item Overdue</h2>
        <p style="color: #f8fafc; font-size: 15px; line-height: 1.6; margin: 0;">
          This is an urgent reminder that <strong style="color: #f8fafc;"><%= @item_title %></strong> borrowed from <strong style="color: #06b6d4;"><%= @lender.name %></strong> is overdue. Please arrange to return it as soon as possible.
        </p>
      </div>
    <% else %>
      <h2 style="color: #06b6d4; font-size: 20px; font-weight: 700; margin: 0 0 16px 0;">Return Reminder</h2>
      <p style="color: #f8fafc; font-size: 15px; line-height: 1.6; margin: 0 0 20px 0;">
        This is a friendly reminder that <strong style="color: #f8fafc;"><%= @item_title %></strong> borrowed from <strong style="color: #06b6d4;"><%= @lender.name %></strong> is due
        <% if @days == 0 %>
          <strong style="color: #06b6d4;">today</strong>.
        <% elsif @days == 1 %>
          in <strong style="color: #06b6d4;">1 day</strong>.
        <% else %>
          in <strong style="color: #06b6d4;"><%= @days %> days</strong>.
        <% end %>
      </p>
    <% end %>

    <div style="text-align: center; margin-top: 28px;">
      <%= link_to "View Borrow Details", borrow_requests_url, style: "display: inline-block; background-color: #{@overdue ? '#ef4444' : '#06b6d4'}; color: #{@overdue ? '#ffffff' : '#0b0f19'}; font-weight: 600; font-size: 15px; padding: 12px 24px; border-radius: 8px; text-decoration: none;" %>
    </div>

    <div style="margin-top: 32px; padding-top: 20px; border-top: 1px solid #2e374a; text-align: center;">
      <p style="color: #94a3b8; font-size: 12px; line-height: 1.5; margin: 0;">
        You're receiving this because you have borrow notifications enabled in your Trove settings.
      </p>
    </div>
  </div>
</div>
