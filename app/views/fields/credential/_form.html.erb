<div class="field-unit__label"><%= f.label field.attribute %></div>
<div class="field-unit__field"><%= f.password_field field.attribute, value: nil, autocomplete: 'new-password' %><small>Stored value is hidden. Leave blank to keep it; enter a new value to replace it.</small><% if field.data.present? %><label class="credential-clear"><%= check_box_tag "#{f.object_name}[clear_credentials][]", field.attribute, false %> Clear saved value on save</label><% end %></div>
