<% trackable = activity.trackable %>
<% return if trackable.nil? %>

<div class="activity-card">
  <div class="activity-thumbnail">
    <% if trackable.respond_to?(:stored_cover_url) && trackable.stored_cover_url.present? %>
      <img src="<%= trackable.stored_cover_url %>" alt="Cover">
    <% else %>
      <span class="fallback-icon">
        <%= case activity.trackable_type
            when 'Movie' then ui_icon('film')
            when 'Album' then ui_icon('disc')
            when 'Comic' then ui_icon('library')
            when 'TvShow' then ui_icon('tv')
            when 'VideoGame' then ui_icon('gamepad')
            when 'Book' then ui_icon('book')
            when 'WrestlingEvent' then ui_icon('wrestling')
            else ui_icon('archive')
            end %>
      </span>
    <% end %>
  </div>

  <div class="activity-body">
    <div class="activity-header">
      <span class="activity-text">
        <%= activity_link_description(activity) %>
      </span>
      <% if trackable.respond_to?(:review) && trackable.review.present? && activity.activity_type == 'reviewed' %>
        <div class="activity-review-quote">
          <%= review_summary(trackable, author: activity.user, compact: true, permalink: activity.activity_type == 'reviewed') %>
        </div>
      <% end %>
    </div>

    <div class="activity-footer">
      <div style="display: flex; gap: 12px; align-items: center;">
        <span class="activity-badge badge-<%= activity.activity_type %>">
          <%= activity.display_type %>
        </span>
        <span class="activity-time">
          <%= time_ago_in_words(activity.created_at) %> ago
        </span>
      </div>
      <div class="activity-actions">
        <%= render partial: 'likes/like_button', locals: { item: activity, tweet_style: true } %>
      </div>
    </div>
  </div>
</div>
