<div class="page-header">
  <h1>Search Results</h1>
  
  <div class="search-filters">
    <form action="<%= search_path %>" method="get" class="search-results-form" data-turbo-action="advance">
      <div class="search-input-wrapper">
        <input type="text" name="q" aria-label="Search media" value="<%= @query %>" class="search-input" placeholder="Search Trove..." autocomplete="off">
        <button type="submit" class="search-submit" aria-label="Submit search">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </div>
      
      <div class="filter-tabs">
        <% { '' => 'All', 'movies' => 'Movies', 'albums' => 'Albums', 'comics' => 'Comics', 'tv_shows' => 'TV Shows', 'video_games' => 'Games', 'books' => 'Books' }.each do |key, label| %>
          <% selected = @filter_type.to_s == key %>
          <button type="submit" name="type" value="<%= key %>" class="filter-tab <%= 'active' if selected %>" aria-pressed="<%= selected %>"><%= label %></button>
        <% end %>
      </div>
    </form>
  </div>
</div>

<% if @query.present? %>
  <div class="search-results-container">
    <% has_results = @entities.present? %>
    <% if @entities.present? %>
      <section class="collection-section"><h2>People &amp; Metadata</h2><div class="entity-grid">
        <% @entities.each do |entity| %><%= link_to entity, class: 'entity-tile' do %><span><strong><%= entity.name %></strong><small><%= entity.kind.titleize %></small></span><% end %><% end %>
      </div></section>
    <% end %>

    <% @results.each do |category, items| %>
      <% next if items.empty? %>
      <% has_results = true %>
      <section class="collection-section">
        <h2><%= category.to_s.titleize %> <small>(<%= @result_counts[category] %>)</small></h2>
        <div class="media-grid-2026">
          <%= render partial: 'shared/media_card', collection: items, as: :media_item %>
        </div>
        <% if @filter_type.present? %>
          <%= paginate items, params: { q: @query, type: @filter_type } %>
        <% elsif @result_counts[category] > items.size %>
          <%= link_to "View all #{@result_counts[category]} #{category.to_s.humanize.downcase}", search_path(q: @query, type: category), class: 'sleek-btn sleek-btn-secondary' %>
        <% end %>
      </section>
    <% end %>

    <% unless has_results %>
      <div class="empty-state">
        <%= link_to "Search all types from the first page", search_path(q: @query) %>
        <p>No results found for "<%= @query %>" in <%= @filter_type.present? ? @filter_type.titleize : 'any category' %>.</p>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <p>Enter a search term above to find media in Trove.</p>
  </div>
<% end %>
