<div class="page-header"><h1><%= @user.name %>'s game shelf</h1></div>
<p>Games and gameplay status explicitly shared by this member.</p>
<nav class="game-library-nav" aria-label="Public game shelf filters">
  <%= link_to 'All shared games', game_shelf_path(@user) %>
  <%= link_to 'Favorites', game_shelf_path(@user, favorites: '1') %>
  <%= link_to 'Currently playing', game_shelf_path(@user, status: 'currently_playing') %>
  <%= link_to 'Completed', game_shelf_path(@user, status: 'completed') %>
  <%= link_to 'Member profile', user_path(@user) %>
</nav>
<% if @games.empty? %><p>No games are shared in this view.</p><% end %>
<div class="media-grid-2026">
  <% @games.each do |library| %><% game = library.item %>
    <article class="card-2026 game-library-card">
      <div class="card-2026-cover"><%= image_tag game_library_cover(game, library), alt: "#{game.title} cover", loading: 'lazy', decoding: 'async' %></div>
      <div class="card-2026-content">
        <h2 class="card-2026-title"><%= link_to game.title, game %></h2>
        <% if library.game_favorite? %><p>Favorite game</p><% end %>
        <p><%= library.game_playthroughs.map { |run| "#{run.status.humanize} (#{run.progress}%)" }.uniq.join(' · ') %></p>
        <% if library.rating.present? %><p>Rating: <%= library.rating %> / 5</p><% end %>
      </div>
    </article>
  <% end %>
</div>
<div class="pagination-wrapper"><%= paginate @games %></div>
