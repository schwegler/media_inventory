<% season = available_season %>
<!DOCTYPE html>
<html lang="en" data-theme="<%= logged_in? ? current_user.theme : 'os' %>"
      data-accent="<%= logged_in? ? current_user.accent_theme : 'violet' %>"
      data-density="<%= logged_in? ? current_user.content_density : 'comfortable' %>"
      data-media-layout="<%= logged_in? ? current_user.media_layout : 'covers' %>"
      data-effects="<%= logged_in? && current_user.reduce_effects? ? 'reduced' : 'full' %>">
<head>
  <meta charset="utf-8">
  <title><%= full_title(yield(:title)) %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="<%= yield(:meta_description).presence || "A home for every story, album, and game you're into. Build your shelf across 6 media formats, track active series, and share honest takes on Trove." %>">
  <meta property="og:title" content="<%= full_title(yield(:title)) %>">
  <meta property="og:description" content="<%= yield(:meta_description).presence || "A home for every story, album, and game you're into. Build your shelf across 6 media formats, track active series, and share honest takes on Trove." %>">
  <meta property="og:url" content="<%= request.original_url %>">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= public_preview_image_url(@preview_image ? rails_blob_path(@preview_image, only_path: true) : nil) %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= full_title(yield(:title)) %>">
  <meta name="twitter:description" content="<%= yield(:meta_description).presence || "A home for every story, album, and game you're into. Build your shelf across 6 media formats, track active series, and share honest takes on Trove." %>">
  <meta name="twitter:image" content="<%= public_preview_image_url(@preview_image ? rails_blob_path(@preview_image, only_path: true) : nil) %>">
  <meta property="og:site_name" content="Trove">
  <!-- Favicons and App Icons -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/brand/trove_favicon_32px.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/brand/trove_rounded_app_icon.png">
  <meta name="theme-color" content="#7C3AED" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#161320" media="(prefers-color-scheme: dark)">
  <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
  <%= javascript_importmap_tags %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
</head>
<body class="shelf-page" data-controller="<%= 'halloween' if season %>" data-halloween-config-value="<%= SeasonalHelper::SEASON_CONFIG.to_json if season %>" data-action="turbo:render@document->halloween#refresh turbo:before-cache@document->halloween#reset trove:base-appearance@document->halloween#baseChoice" data-seasonal-preferences-url="<%= settings_appearance_path if logged_in? %>" data-viewer-id="<%= logged_in? ? current_user.id : 'guest' %>" data-ui-preferences="<%= ui_preferences.to_json %>" <% if hotwire_native_app? %>data-native="true"<% end %>>
  <a class="skip-link" href="#main-content">Skip to shelves</a>
  <%= render 'shared/site_navigation' %>
  <%= render 'shared/halloween_invitation' %>
  <main id="main-content" tabindex="-1"><%= yield %></main>

  <%= turbo_frame_tag "modal" %>
</body>
</html>
