<!DOCTYPE html>
<html lang="en" data-theme="<%= logged_in? ? current_user.theme : 'os' %>"
      data-accent="<%= logged_in? ? current_user.accent_theme : 'violet' %>"
      data-density="<%= logged_in? ? current_user.content_density : 'comfortable' %>"
      data-media-layout="<%= logged_in? ? current_user.media_layout : 'covers' %>"
      data-effects="<%= logged_in? && current_user.reduce_effects? ? 'reduced' : 'full' %>">
<head>
  <title><%= full_title(yield(:title)) %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="turbo-prefetch" content="true">
  <meta name="view-transition" content="same-origin">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">

  <!-- Open Graph -->
  <meta property="og:site_name" content="Trove">
  <meta property="og:title" content="<%= full_title(yield(:title)) %>">
  <meta property="og:description" content="<%= yield(:meta_description).presence || "A home for every story, album, and game you're into. Log what you watch, read, play, and spin—without algorithmic clutter. Build your shelf across 6 media formats, track active series, and share honest takes on Trove." %>">
  <meta property="og:image" content="<%= public_preview_image_url(yield(:meta_image)) %>">
  <meta property="og:url" content="<%= yield(:canonical_url).presence || request.original_url %>">
  <% if content_for?(:canonical_url) %><link rel="canonical" href="<%= yield(:canonical_url) %>"><% end %>
  <meta property="og:type" content="<%= yield(:og_type).presence || "website" %>">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= full_title(yield(:title)) %>">
  <meta name="twitter:description" content="<%= yield(:meta_description).presence || "A home for every story, album, and game you're into. Log what you watch, read, play, and spin—without algorithmic clutter. Build your shelf across 6 media formats, track active series, and share honest takes on Trove." %>">
  <meta name="twitter:image" content="<%= public_preview_image_url(yield(:meta_image)) %>">

  <!-- Favicons and App Icons -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/brand/trove_favicon_32px.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/brand/trove_rounded_app_icon.png">
  <meta name="theme-color" content="#7C3AED" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#161320" media="(prefers-color-scheme: dark)">
  <%= stylesheet_link_tag "application", "data-turbo-track": Rails.env.production? ? "reload" : "" %>
  <%= javascript_importmap_tags %>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <% if hotwire_native_app? %>
    <meta name="turbo-visit-control" content="reload">
  <% end %>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-PPD2TWSZBW"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-PPD2TWSZBW');
  </script>
</head>
<body class="<%= 'item-detail' if content_for?(:item_detail) %> <%= 'media-workspace' if content_for?(:media_workspace) %>" data-controller="artwork form-errors" data-viewer-id="<%= logged_in? ? current_user.id : 'guest' %>" data-ui-preferences="<%= ui_preferences.to_json %>" <% if hotwire_native_app? %>data-native="true"<% end %>>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <% if content_for?(:header_artwork) %>
    <div class="item-page-artwork" aria-hidden="true">
      <%= image_tag yield(:header_artwork), alt: '', class: 'item-page-artwork-image' %>
    </div>
  <% end %>

  <%= render 'shared/site_navigation' %>

<main id="main-content" tabindex="-1" class="container">
  <div id="flash-messages">
    <% flash.each do |message_type, message| %>
      <% next if message_type.to_s == "metadata_result" %>
      <div class="alert alert-<%= message_type %>" data-controller="flash" data-flash-dismiss-after-value="0" role="status" aria-live="polite">
        <span><%= message %></span>
        <button type="button" class="btn-unstyled flash-dismiss" data-action="flash#dismiss" aria-label="Dismiss message">×</button>
      </div>
    <% end %>
  </div>
  <%= yield %>
</main>

<footer class="app-footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-copyright">
        <div class="footer-brand"><div class="footer-wordmark"><%= image_tag 'brand/trove_rounded_app_icon.png', width: 32, height: 32, alt: '', class: 'footer-logo', loading: 'lazy' %><strong>trove</strong></div><span>A library companion to taco ’bout it.</span></div>
      </div>
      <a class="blog-link" href="https://tacobout.online/">Visit the blog <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg></a>
    </div>
    <div class="footer-attribution">
        <%= image_tag "tmdb_logo.svg", alt: "TMDB Logo", class: "tmdb-logo" %>
        <p class="attribution-text">This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
    </div>
  </div>
</footer>

  <button type="button" class="back-to-top" data-controller="back-to-top"
          data-action="click->back-to-top#scrollToTop scroll@window->back-to-top#update"
          aria-label="Back to top" title="Back to top" hidden>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 12 6-6 6 6M12 6v14"/></svg>
  </button>

  <% unless ['new', 'edit'].include?(action_name) %>
    <%= turbo_frame_tag "modal" %>
  <% end %>

</body>
</html>
