<% headline = @collection&.title || @user.shelf_headline.presence || "The things I keep." %>
<% category_label = @collection ? 'Collection' : @overview ? 'Shelf overview' : FavoriteShelf::CATEGORIES[@category] %>
<% content_for :title, h("#{headline} · #{category_label} · #{@user.name}’s Shelf") %>
<% content_for :meta_description, h("#{headline} — #{category_label} selections by #{@user.name} on Trove.") %>
<% flash.each do |type, message| %><p class="alert alert-<%= type %>" role="status"><%= message %></p><% end %>
<section data-favorite-shelf-preview-stored-value="<%= @preview_image.present? %>" data-favorite-shelf-preview-theme-value="<%= @theme %>" data-favorite-shelf-owner-value="<%= @shelf_owner %>" data-favorite-shelf-preview-category-value="<%= @preview_category %>" data-favorite-shelf-preview-signature-value="<%= @preview_signature %>" data-favorite-shelf-headline-value="<%= headline %>" data-favorite-shelf-style-value="<%= @image_style.to_json %>" data-favorite-shelf-assets-value="<%= { telly: asset_path('brand/telly_shelf.png'), facet: asset_path('brand/facet_shelf.png'), bat: asset_path('brand/facet_bat_costume_2026.png') }.to_json %>" class="favorite-shelf" data-shelf-theme="<%= @theme %>" data-controller="favorite-shelf" data-favorite-shelf-url-value="<%= shelf_path(@user.username, category: @category, collection: @collection&.slug) %>" data-favorite-shelf-search-value="<%= search_shelves_path(category: @category) %>" data-favorite-shelf-picks-value="<%= shelf_pick_data(@items).to_json %>" data-favorite-shelf-shelves-value="<%= @shelves.map { |s| { label: s[:label], picks: shelf_pick_data(s[:items]) } }.to_json %>" data-favorite-shelf-overview-value="<%= @overview %>" data-favorite-shelf-handle-value="<%= @user.username %>" data-favorite-shelf-category-value="<%= (@collection ? "Collection" : FavoriteShelf::CATEGORIES[@category]) %>">
  <nav class="shelf-toolbar" aria-label="Shelf navigation">
    <div class="shelf-toolbar-links">
      <%= link_to (@shelf_owner ? 'View shelf overview' : 'All shelves'), shelf_navigation_path(@user, theme: @theme, style: @image_style), class: "#{'shelf-primary' if @shelf_owner} shelf-overview-link", data: { shelf_link: true }, aria: { current: @overview ? 'page' : nil } %>
      <% if @shelf_owner && @overview %><%= link_to 'Edit selections', shelf_navigation_path(@user, category: 'overall', theme: @theme, style: @image_style), data: { shelf_link: true } %><% end %>
      <% if @shelf_owner %><%= link_to 'Customize profile', settings_path %><%= link_to 'Preview as visitor', shelf_path(@user.username, category: @overview ? nil : @category, collection: @collection&.slug, view: 'visitor') %><% end %>
      <%= link_to 'View profile', handle_profile_path(@user.username) %>
      <a href="#shelf-sharing">Share</a>
    </div>
    <% if @shelf_owner %><p class="shelf-view-state"><%= @overview ? 'Viewing shelf overview' : (@collection ? "Editing collection" : "Editing #{FavoriteShelf::CATEGORIES[@category]} selections") %></p><% end %>
    <% if @shelf_owner %><fieldset class="shelf-themes"><legend>Theme</legend><% (%w[everyday halloween christmas midnight_feature] + [@theme]).uniq.each do |theme| %><label><input type="radio" name="shelf-theme" value="<%= theme %>" <%= 'checked' if @theme == theme %> data-action="favorite-shelf#theme"><span><%= shelf_theme_label(theme) %></span></label><% end %></fieldset><% end %>
  </nav>
  <p class="shelf-screening-note">the late show. questionable decisions.</p>
  <div class="shelf-companion" hidden><img alt="" width="96" height="126" decoding="async" data-favorite-shelf-target="companion"></div>
  <% if @overview && !@shelf_owner && @shelves.all? { |shelf| shelf[:items].empty? } && @collections.empty? %>
    <header class="shelf-heading"><h1 title="<%= headline %>"><% if @user.shelf_headline.present? %><%= headline %><% else %>A shelf<br>taking shape.<% end %></h1></header>
    <p><%= @user.name %> hasn't chosen selections yet. Their library has more to explore.</p>
    <%= link_to "Explore #{@user.name}’s library", handle_profile_path(@user.username), class: 'shelf-primary' %>
    <nav class="shelf-categories" aria-label="Shelf categories"><% @shelves.each do |shelf|; key = shelf[:key]; label = shelf[:label] %><%= link_to label, shelf_path(@user.username, category: key, theme: @theme), data: { shelf_link: true } %><% end %></nav>
  <% elsif @overview %>
    <div class="shelf-introduction"><header class="shelf-heading"><%= link_to "#{@user.name}’s Shelf", shelf_navigation_path(@user, theme: @theme, style: @image_style), data: { shelf_link: true } %><h1><% if @user.shelf_headline.present? %><%= @user.shelf_headline %><% else %>The things<br>I keep.<% end %></h1>
      <% if @shelf_owner %>
        <details class="shelf-headline-editor"><summary>Edit headline</summary>
          <%= form_with url: shelf_path(@user.username, theme: @theme), method: :patch do |form| %>
            <%= form.label :shelf_headline, 'Shelf headline' %>
            <%= form.text_field :shelf_headline, value: @user.shelf_headline, placeholder: 'The things I keep.', maxlength: 80, aria: { describedby: 'shelf-headline-hint' } %>
            <p id="shelf-headline-hint">Up to 80 characters. Leave blank to use the default.</p>
            <%= form.submit 'Save headline', class: 'shelf-primary' %>
          <% end %>
        </details>
      <% end %></header><%= render 'exhibit', shelf: @shelves.first, index: 0, featured: true if @shelves.any? %></div>
    <div class="shelf-exhibition"><% @shelves.drop(1).each_with_index do |shelf, index| %><%= render 'exhibit', shelf: shelf, index: index + 1, featured: false %><% end %></div>
  <% else %>
    <header class="shelf-heading shelf-detail-heading"><%= link_to "#{@user.name}’s Shelf", shelf_navigation_path(@user, theme: @theme, style: @image_style), data: { shelf_link: true } %><h1 title="<%= headline %>"><span class="shelf-custom-title"><%= headline %></span><span><%= @collection&.description.presence || "#{category_label} · selections" %></span></h1></header>
    <nav class="shelf-categories" aria-label="Shelf categories"><% @shelves.each do |shelf|; key = shelf[:key]; label = shelf[:label] %><%= link_to label, shelf_path(@user.username, category: key, theme: @theme), data: { shelf_link: true }, aria: { current: @category == key ? 'page' : nil } %><% end %></nav>
    <% if @shelf_owner && @collection %><details class="shelf-headline-editor"><summary>Edit collection details</summary><%= form_with url: shelf_path(@user.username, collection: @collection.slug), method: :patch, scope: :collection_details do |form| %><%= form.label :title, 'Collection title' %><%= form.text_field :title, value: @collection.title, required: true, maxlength: 80 %><%= form.label :description, 'A little context' %><%= form.text_field :description, value: @collection.description, maxlength: 240 %><%= form.submit 'Save collection details', class: 'shelf-primary' %><% end %></details><% end %>
    <% if @shelf_owner %><p class="shelf-edit-hint">Choose a cover to find a pick. Reorder your picks, then save your public shelf.</p><% end %>
    <% if @items.empty? %><p class="shelf-empty-state"><%= @shelf_owner ? "Your collection starts here. Choose a cover below to add a pick." : "No public picks here yet. Explore the other shelves above." %></p><% end %>
    <div class="favorite-shelf-slots" data-favorite-shelf-target="slots" data-owner="<%= @shelf_owner %>"></div>
    <noscript><ol><% @items.each do |item| %><li><%= link_to item.title, item %></li><% end %></ol><p>Enable JavaScript to edit your shelf and download its share image.</p></noscript>
    <% if @shelf_owner %>
      <button type="button" class="shelf-primary" data-action="favorite-shelf#save">Save shelf</button>
      <dialog data-favorite-shelf-target="dialog" aria-labelledby="shelf-picker-heading"><div class="shelf-picker"><h2 id="shelf-picker-heading">Find a pick</h2><button type="button" data-action="favorite-shelf#close" aria-label="Close search">Close</button><div class="shelf-search-sources"><button type="button" data-action="favorite-shelf#localSource" aria-pressed="true">Trove library</button><button type="button" data-action="favorite-shelf#externalSource" aria-pressed="false">Search external catalog</button></div><label for="shelf-search-type">Media type</label><select id="shelf-search-type" data-favorite-shelf-target="searchType" data-action="change->favorite-shelf#search"><%= options_for_select(FavoriteShelf::CATEGORIES.except('overall').select { |key, _| @category == 'overall' || key == @category }.map { |key, label| [label, key.underscore] }, @category == 'overall' ? 'movie' : @category.underscore) %></select><label for="shelf-search">Search titles</label><input id="shelf-search" type="search" autofocus placeholder="Start typing a title…" autocomplete="off" data-favorite-shelf-target="query" data-action="input->favorite-shelf#search"><div data-favorite-shelf-target="results" aria-live="polite">Search across the catalog. No need to add it to your library first.</div></div></dialog>
    <% end %>
  <% end %>
  <% if @overview %>
    <section class="shelf-collections" aria-label="Collections">
      <% @collections.each do |collection| %><article><div class="shelf-collection-covers"><% collection.items.each do |item| %><% if item.stored_cover_url.present? %><%= image_tag item.stored_cover_url, alt: item.title, loading: 'lazy' %><% end %><% end %></div><h2><%= link_to collection.title, shelf_path(@user.username, collection: collection.slug) %></h2><p><%= collection.description %></p><p><%= pluralize(collection.items.size, 'pick') %></p></article><% end %>
      <% if @shelf_owner %><details><summary>Create a collection</summary><p>Keep Halloween, Christmas and everyday discoveries on their own shelves. Up to five picks, across every media type.</p><%= form_with url: shelf_path(@user.username), method: :patch, scope: :new_collection do |form| %><%= form.label :title, 'Collection title' %><%= form.text_field :title, required: true, maxlength: 80, placeholder: 'Something for a winter night' %><%= form.label :description, 'A little context (optional)' %><%= form.text_field :description, maxlength: 240 %><%= form.label :theme, 'Starting mood' %><%= form.select :theme, [['Everyday', 'everyday'], ['Halloween', 'halloween'], ['Christmas', 'christmas']] %><%= form.submit 'Create collection', class: 'shelf-primary' %><% end %></details><% end %>
    </section>
  <% end %>
  <% unless @shelf_owner %><aside class="shelf-visitor-cta"><p>Good taste deserves a shelf. Bring together the books, films, music and games you keep coming back to.</p><%= link_to 'Make your own shelf', logged_in? ? my_shelf_path : signup_path, class: 'shelf-primary' %></aside><% end %>
  <section class="shelf-sharing" id="shelf-sharing" aria-labelledby="shelf-share-heading">
    <div><h2 id="shelf-share-heading"><%= @shelf_owner ? "Share your shelf" : "Share this collection" %></h2><p>Save a little piece of your world.<br>A cover worth pausing for. A collection worth opening.</p></div>
    <fieldset class="shelf-formats"><legend>Image format</legend><label><input type="radio" name="shelf-format" value="landscape" data-action="favorite-shelf#format"><span class="shelf-format-shape landscape" aria-hidden="true"></span><span>Landscape<small>1200 × 630</small></span></label><label><input type="radio" name="shelf-format" value="portrait" checked data-action="favorite-shelf#format"><span class="shelf-format-shape portrait" aria-hidden="true"></span><span>Instagram Story<small>1080 × 1920 · room for stickers</small></span></label></fieldset>
    <% if @shelf_owner %><fieldset class="shelf-customization"><legend>Make the image yours</legend>
      <fieldset class="shelf-layout-cards"><legend>Layout</legend><% [['exhibition', 'Gallery', 'Balanced full covers'], ['collector', 'Feature', 'One lead pick, supporting discoveries'], ['mixtape', 'Mixtape', 'A relaxed cover collage']].each do |value, label, description| %><label><input type="radio" name="layout" aria-label="<%= label %> layout" value="<%= value %>" <%= 'checked' if @image_style['layout'] == value %> data-action="favorite-shelf#customize"><span class="shelf-layout-sample <%= value %>" aria-hidden="true"><% 5.times do %><i></i><% end %></span><strong><%= label %></strong><small><%= description %></small></label><% end %></fieldset>
      <% if @image_style['layout'] == 'reading' %><label for="shelf-layout">Legacy layout</label><select id="shelf-layout" name="layout" data-action="favorite-shelf#customize"><option value="reading" selected>Reading list</option></select><% end %>
      <details class="shelf-advanced"><summary>Advanced appearance</summary><label for="shelf-all-palettes">All palettes</label><select id="shelf-all-palettes" name="shelf-theme" data-action="favorite-shelf#theme"><%= options_for_select(ShelvesHelper::SHELF_THEMES.map { |theme| [shelf_theme_label(theme), theme] }, @theme) %></select><label for="shelf-texture">Background</label><select id="shelf-texture" name="texture" data-action="favorite-shelf#customize"><%= options_for_select([['Clean', 'clean'], ['Paper grain', 'paper'], ['Star field', 'stars']], @image_style['texture']) %></select>
      <label for="shelf-companion">Mascot</label><select id="shelf-companion" name="companion" data-action="favorite-shelf#customize"><%= options_for_select([['Match theme', 'auto'], ['None', 'none'], ['Telly', 'telly'], ['Facet', 'facet'], ['Facet in bat costume', 'bat']], @image_style['companion']) %></select>
      <p>Curated, readable defaults. Your layout, background and companion travel with copied shelf links.</p>
      </details><button type="button" class="shelf-primary" data-action="favorite-shelf#savePresentation">Save appearance</button>
    </fieldset><% end %>
    <% if @shelf_owner %><div class="shelf-publish"><p>Publish a preview after saving selections so social links show your current shelf image.</p><button type="button" class="shelf-copy" data-action="favorite-shelf#publishPreview">Publish share preview</button></div><% end %>
    <div class="shelf-share-actions"><button type="button" class="shelf-copy shelf-download" data-action="favorite-shelf#download"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 15v6h16v-6"/></svg><%= @shelf_owner ? "Save & download image" : "Download image" %></button><button type="button" class="shelf-primary" data-action="favorite-shelf#copyLink">Copy collection link</button><button type="button" class="shelf-copy" data-action="favorite-shelf#copyAltText">Copy image alt text</button></div>
  </section>
  <details class="shelf-alt-text" data-favorite-shelf-target="altTextDetails"><summary>Image alt text</summary><label for="shelf-image-alt-text">Description of your share image</label><textarea id="shelf-image-alt-text" rows="8" readonly data-favorite-shelf-target="altText"></textarea></details>
  <p role="status" aria-live="polite" data-favorite-shelf-target="status"></p>
  <details open class="shelf-preview" data-action="toggle->favorite-shelf#previewVisible"><summary>Share image preview</summary><canvas width="1080" height="1920" data-favorite-shelf-target="canvas" aria-label="Shelf share image preview"></canvas></details>
</section>
