<% content_for :title, "#{@user.name}’s Shelf" %>
<% content_for :meta_description, "The things that stay with #{@user.name}. Explore seven shelves of personal favorites on Trove." %>
<% headline = @user.shelf_headline.presence || "The things I keep." %>
<% flash.each do |type, message| %><p class="alert alert-<%= type %>" role="status"><%= message %></p><% end %>
<section data-favorite-shelf-preview-stored-value="<%= @preview_image.present? %>" data-favorite-shelf-preview-theme-value="<%= @theme %>" data-favorite-shelf-owner-value="<%= current_user?(@user) %>" data-favorite-shelf-preview-category-value="<%= @preview_category %>" data-favorite-shelf-preview-signature-value="<%= @preview_signature %>" data-favorite-shelf-headline-value="<%= headline %>" class="favorite-shelf" data-shelf-theme="<%= @theme %>" data-controller="favorite-shelf" data-favorite-shelf-url-value="<%= shelf_path(@user.username, category: @category) %>" data-favorite-shelf-search-value="<%= search_shelves_path(category: @category) %>" data-favorite-shelf-picks-value="<%= shelf_pick_data(@items).to_json %>" data-favorite-shelf-shelves-value="<%= @shelves.map { |s| { label: s[:label], picks: shelf_pick_data(s[:items]) } }.to_json %>" data-favorite-shelf-overview-value="<%= @overview %>" data-favorite-shelf-handle-value="<%= @user.username %>" data-favorite-shelf-category-value="<%= FavoriteShelf::CATEGORIES[@category] %>">
  <nav class="shelf-toolbar" aria-label="Shelf navigation">
    <div class="shelf-toolbar-links">
      <% if current_user?(@user) %><%= link_to 'Curate favorites', shelf_path(@user.username, category: @category, theme: @theme), data: { shelf_link: true } %><%= link_to 'Customize profile', settings_path %><% end %>
      <% unless @overview %><%= link_to 'All shelves', shelf_path(@user.username, theme: @theme), data: { shelf_link: true } %><% end %>
      <a href="#shelf-sharing">Share</a>
    </div>
    <fieldset class="shelf-themes"><legend>Theme</legend><% %w[midnight gallery electric halloween].each do |theme| %><label><input type="radio" name="shelf-theme" value="<%= theme %>" <%= 'checked' if @theme == theme %> data-action="favorite-shelf#theme"><span><%= theme.capitalize %></span></label><% end %></fieldset>
  </nav>
  <% if @overview && !current_user?(@user) && @shelves.all? { |shelf| shelf[:items].empty? } %>
    <header class="shelf-heading"><h1>A shelf<br>taking shape.</h1></header>
    <p><%= @user.name %> hasn't chosen favorites yet. Their library has more to explore.</p>
    <%= link_to "Explore #{@user.name}’s library", handle_profile_path(@user.username), class: 'shelf-primary' %>
    <nav class="shelf-categories" aria-label="Shelf categories"><% FavoriteShelf::CATEGORIES.each do |key, label| %><%= link_to label, shelf_path(@user.username, category: key, theme: @theme), data: { shelf_link: true } %><% end %></nav>
  <% elsif @overview %>
    <div class="shelf-introduction"><header class="shelf-heading"><%= link_to "#{@user.name}’s Shelf", handle_profile_path(@user.username) %><h1><% if @user.shelf_headline.present? %><%= @user.shelf_headline %><% else %>The things<br>I keep.<% end %></h1>
      <% if current_user?(@user) %>
        <details class="shelf-headline-editor"><summary>Edit headline</summary>
          <%= form_with url: shelf_path(@user.username, theme: @theme), method: :patch do |form| %>
            <%= form.label :shelf_headline, 'Shelf headline' %>
            <%= form.text_field :shelf_headline, value: @user.shelf_headline, placeholder: 'The things I keep.', maxlength: 80, aria: { describedby: 'shelf-headline-hint' } %>
            <p id="shelf-headline-hint">Up to 80 characters. Leave blank to use the default.</p>
            <%= form.submit 'Save headline', class: 'shelf-primary' %>
          <% end %>
        </details>
      <% end %></header><%= render 'exhibit', shelf: @shelves.first, index: 0, featured: true %></div>
    <div class="shelf-exhibition"><% @shelves.drop(1).each_with_index do |shelf, index| %><%= render 'exhibit', shelf: shelf, index: index + 1, featured: false %><% end %></div>
  <% else %>
    <header class="shelf-heading shelf-detail-heading"><%= link_to "#{@user.name}’s Shelf", handle_profile_path(@user.username) %><h1><%= FavoriteShelf::CATEGORIES[@category] %><span>Five favorites. Entirely personal.</span></h1></header>
    <nav class="shelf-categories" aria-label="Shelf categories"><% FavoriteShelf::CATEGORIES.each do |key, label| %><%= link_to label, shelf_path(@user.username, category: key, theme: @theme), data: { shelf_link: true }, aria: { current: @category == key ? 'page' : nil } %><% end %></nav>
    <% if current_user?(@user) %><p class="shelf-edit-hint">Choose a cover to find a favorite. Reorder your picks, then save your public shelf.</p><% end %>
    <div class="favorite-shelf-slots" data-favorite-shelf-target="slots" data-owner="<%= current_user?(@user) %>"></div>
    <noscript><ol><% @items.each do |item| %><li><%= link_to item.title, item %></li><% end %></ol><p>Enable JavaScript to edit your shelf and download its share image.</p></noscript>
    <% if current_user?(@user) %>
      <button type="button" class="shelf-primary" data-action="favorite-shelf#save">Save shelf</button>
      <dialog data-favorite-shelf-target="dialog" aria-labelledby="shelf-picker-heading"><div class="shelf-picker"><h2 id="shelf-picker-heading">Find a favorite</h2><button type="button" data-action="favorite-shelf#close" aria-label="Close search">Close</button><label for="shelf-search">Search titles</label><input id="shelf-search" type="search" placeholder="Start typing a title…" autocomplete="off" data-favorite-shelf-target="query" data-action="input->favorite-shelf#search"><div data-favorite-shelf-target="results" aria-live="polite">Search across the catalog. No need to add it to your library first.</div></div></dialog>
    <% end %>
  <% end %>
  <section class="shelf-sharing" id="shelf-sharing" aria-labelledby="shelf-share-heading">
    <div><h2 id="shelf-share-heading">Share your shelf</h2><p>Save a little piece of your world.<br>Ready for your feed or your story.</p></div>
    <fieldset class="shelf-formats"><legend>Image format</legend><label><input type="radio" name="shelf-format" value="landscape" checked data-action="favorite-shelf#format"><span class="shelf-format-shape landscape" aria-hidden="true"></span><span>Landscape<small>1200 × 630</small></span></label><label><input type="radio" name="shelf-format" value="portrait" data-action="favorite-shelf#format"><span class="shelf-format-shape portrait" aria-hidden="true"></span><span>Portrait<small>1080 × 1920</small></span></label></fieldset>
    <% if current_user?(@user) %><p>Publish a preview after saving favorites so social links show your current shelf image.</p><button type="button" class="shelf-copy" data-action="favorite-shelf#publishPreview">Publish share preview</button><% end %>
    <div class="shelf-share-actions"><button type="button" class="shelf-copy shelf-download" data-action="favorite-shelf#download"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 15v6h16v-6"/></svg>Download share image</button><button type="button" class="shelf-primary" data-action="favorite-shelf#copyLink">Copy shelf link</button><button type="button" class="shelf-copy" data-action="favorite-shelf#copyAltText">Copy image alt text</button></div>
  </section>
  <details class="shelf-alt-text" data-favorite-shelf-target="altTextDetails"><summary>Image alt text</summary><label for="shelf-image-alt-text">Description of your share image</label><textarea id="shelf-image-alt-text" rows="8" readonly data-favorite-shelf-target="altText"></textarea></details>
  <p role="status" aria-live="polite" data-favorite-shelf-target="status"></p>
  <details class="shelf-preview" data-action="toggle->favorite-shelf#previewVisible"><summary>Share image preview</summary><canvas width="1200" height="630" data-favorite-shelf-target="canvas" aria-label="Shelf share image preview"></canvas></details>
</section>
