<% headline = @collection&.title || @user.shelf_headline.presence || "The things I keep." %>
<% category_label = @collection ? 'Collection' : @overview ? 'Shelf overview' : FavoriteShelf::CATEGORIES[@category] %>
<% content_for :title, h("#{headline} · #{category_label} · #{@user.name}’s Shelf") %>
<% description = @collection&.description.presence || "#{category_label} selections" %>
<% metadata = @overview ? "#{headline} — Favorite and custom shelves curated by #{@user.name} on Trove." : "#{headline} — #{description}. #{pluralize(@items.size, 'selection')} by #{@user.name} on Trove." %>
<% content_for :meta_description, h(metadata) %>
<% flash.each do |type, message| %><p class="alert alert-<%= type %>" role="status"><%= message %></p><% end %>
<section data-favorite-shelf-edit-version-value="<%= @shelf_edit_version %>" data-favorite-shelf-capacity-value="<%= @collection&.operational_capacity || 5 %>" data-favorite-shelf-flexible-value="<%= @collection.present? %>" data-favorite-shelf-allowed-types-value="<%= (@collection ? @collection.media_types : FavoriteShelf::CATEGORIES.keys.excluding('overall')).to_json %>" data-favorite-shelf-public-url-value="<%= canonical_shelf_url(@user, category: @overview ? nil : @category, collection: @collection&.slug) %>" data-favorite-shelf-preview-stored-value="<%= @preview_image.present? %>" data-favorite-shelf-preview-theme-value="<%= @theme %>" data-favorite-shelf-owner-value="<%= @shelf_owner %>" data-favorite-shelf-preview-category-value="<%= @preview_category %>" data-favorite-shelf-preview-signature-value="<%= @preview_signature %>" data-favorite-shelf-headline-value="<%= headline %>" data-favorite-shelf-style-value="<%= @image_style.to_json %>" data-favorite-shelf-assets-value="<%= { logo: asset_path('brand/trove_rounded_app_icon.png'), telly: asset_path('brand/telly_shelf.png'), facet: asset_path('brand/facet_shelf.png'), bat: asset_path('brand/facet_bat_costume_2026.png') }.to_json %>" class="favorite-shelf" data-shelf-theme="<%= @theme %>" data-controller="favorite-shelf" data-favorite-shelf-url-value="<%= shelf_path(@user.username, category: @overview ? nil : @category, collection: @collection&.slug) %>" data-favorite-shelf-search-value="<%= search_shelves_path(category: @category) %>" data-favorite-shelf-picks-value="<%= shelf_pick_data(@items).to_json %>" data-favorite-shelf-shelves-value="<%= @shelves.map { |s| { label: s[:label], picks: shelf_pick_data(s[:items]) } }.to_json %>" data-favorite-shelf-overview-value="<%= @overview %>" data-favorite-shelf-handle-value="<%= @user.username %>" data-favorite-shelf-category-value="<%= (@collection ? "Collection" : FavoriteShelf::CATEGORIES[@category]) %>">
  <%= render 'toolbar' %>
  <p class="shelf-status" role="status" aria-live="polite" data-favorite-shelf-target="status"></p>
  <% if @overview && !@shelf_owner && @shelves.all? { |shelf| shelf[:items].empty? } && @collections.empty? %>
    <header class="shelf-heading"><h1 title="<%= headline %>"><% if @user.shelf_headline.present? %><%= headline %><% else %>A shelf<br>taking shape.<% end %></h1></header>
    <p><%= @user.name %> hasn't chosen selections yet. Their library has more to explore.</p>
    <%= link_to "Explore #{@user.name}’s library", handle_profile_path(@user.username), class: 'shelf-primary' %>
    <nav class="shelf-categories" aria-label="Shelf categories"><% @shelves.each do |shelf|; key = shelf[:key]; label = shelf[:label] %><%= link_to label, shelf_path(@user.username, category: key, theme: @theme), data: { shelf_link: true } %><% end %></nav>
  <% elsif @overview %>
    <div class="shelf-introduction"><header class="shelf-heading"><%= link_to "#{@user.name}’s Shelf", shelf_navigation_path(@user, theme: @theme, style: @image_style), data: { shelf_link: true } %><h1><% if @user.shelf_headline.present? %><%= @user.shelf_headline %><% else %>The things I keep.<% end %></h1>
      <% if @shelf_owner %>
        <details class="shelf-headline-editor"><summary>Edit headline</summary>
          <%= form_with url: shelf_path(@user.username, theme: @theme), method: :patch do |form| %>
            <%= form.label :shelf_headline, 'Shelf headline' %>
            <%= form.text_field :shelf_headline, value: @user.shelf_headline, placeholder: 'The things I keep.', maxlength: 80, aria: { describedby: 'shelf-headline-hint' } %>
            <p id="shelf-headline-hint">Up to 80 characters. Leave blank to use the default.</p>
            <%= form.submit 'Save headline', class: 'shelf-primary' %>
          <% end %>
        </details>
      <% end %>
      <% if @shelf_owner %><div class="shelf-action-bar"><a class="shelf-primary" href="#new-shelf">Create a shelf</a></div><% end %></header></div>
    <div class="shelf-exhibition"><% @shelves.each_with_index do |shelf, index| %><%= render 'exhibit', shelf: shelf, index: index, featured: false %><% end %></div>
  <% else %>
    <%= render 'header', headline: headline, category_label: category_label %>
    <%= render 'collection_settings', collection: @collection if @shelf_owner && @collection %>
    <% unless @collection %><nav class="shelf-categories" aria-label="Shelf categories"><% @shelves.each do |shelf| %><%= link_to shelf[:label], shelf_path(@user.username, category: shelf[:key]), aria: { current: @category == shelf[:key] ? 'page' : nil } %><% end %></nav><% end %>
    <% if @shelf_owner %><p class="shelf-edit-hint">Choose a cover to replace a title. Use earlier and later buttons to reorder, then save your shelf.</p><% end %>
    <%= render 'empty_state' if @items.empty? %>
    <div class="favorite-shelf-slots" data-favorite-shelf-target="slots" data-owner="<%= @shelf_owner %>">
      <% @items.each_with_index do |item, index| %><%= render 'media_item', item: item, index: index %><% end %>
    </div>
    <noscript><ol><% @items.each do |item| %><li><%= link_to item.title, item %></li><% end %></ol><p>Enable JavaScript to edit your shelf and download its share image.</p></noscript>
    <% if @shelf_owner %>

      <dialog data-favorite-shelf-target="dialog" aria-labelledby="shelf-picker-heading"><div class="shelf-picker"><h2 id="shelf-picker-heading">Find a pick</h2><button type="button" data-action="favorite-shelf#close" aria-label="Close search">Close</button><div class="shelf-search-sources"><button type="button" data-action="favorite-shelf#localSource" aria-pressed="true">Trove library</button><button type="button" data-action="favorite-shelf#externalSource" aria-pressed="false">Search external catalog</button></div><label for="shelf-search-type">Media type</label><select id="shelf-search-type" data-favorite-shelf-target="searchType" data-action="change->favorite-shelf#search"><%= options_for_select(FavoriteShelf::CATEGORIES.except('overall').select { |key, _| @collection ? @collection.media_types.include?(key) : (@category == 'overall' || key == @category) }.map { |key, label| [label, key.underscore] }, @category == 'overall' ? 'movie' : @category.underscore) %></select><label for="shelf-search">Search titles</label><input id="shelf-search" type="search" autofocus placeholder="Start typing a title…" autocomplete="off" data-favorite-shelf-target="query" data-action="input->favorite-shelf#search"><div data-favorite-shelf-target="results" aria-live="polite">Search across the catalog. No need to add it to your library first.</div></div></dialog>
    <% end %>
  <% end %>
  <% if @overview %>
    <section class="shelf-collections" aria-label="Collections">
      <header class="shelf-section-heading"><h2>Custom shelves</h2><p>Collections with room to grow.</p></header>
      <% @collections.each do |collection| %><%= render 'collection_card', collection: collection %><% end %>
      <% if @shelf_owner %><details id="new-shelf" open><summary>Create a shelf</summary><p>Choose a name and collect up to 1,000 titles. Mix media types or choose a specific mix in shelf settings.</p><%= form_with url: shelf_path(@user.username), method: :patch, scope: :new_collection do |form| %><%= form.label :title, 'Shelf title' %><%= form.text_field :title, required: true, maxlength: 80, placeholder: 'Something for a winter night' %><%= form.label :description, 'A little context (optional)' %><%= form.text_field :description, maxlength: 240 %><%= form.label :theme, 'Starting mood' %><%= form.select :theme, [['Everyday', 'everyday'], ['Halloween', 'halloween'], ['Christmas', 'christmas']] %><%= form.submit 'Create shelf', class: 'shelf-primary' %><% end %></details><% end %>
    </section>
  <% end %>
  <% unless @shelf_owner %><aside class="shelf-visitor-cta"><p>Good taste deserves a shelf. Bring together the books, films, music and games you keep coming back to.</p><%= link_to 'Make your own shelf', logged_in? ? my_shelf_path : signup_path, class: 'shelf-primary' %></aside><% end %>
  <details class="shelf-image-settings"><summary>Appearance & share image</summary>
  <p class="shelf-screening-note">the late show. questionable decisions.</p>
  <div class="shelf-companion" hidden><img alt="" width="96" height="126" decoding="async" data-favorite-shelf-target="companion"></div>
  <% if @shelf_owner %><%= render 'theme_controls' %><% end %>
  <section class="shelf-sharing" id="shelf-sharing" aria-labelledby="shelf-share-heading">
    <div><h2 id="shelf-share-heading"><%= @shelf_owner ? "Share your shelf" : "Share this shelf" %></h2><p>Save a little piece of your world.<br>A cover worth pausing for. A collection worth opening.</p></div>
    <fieldset class="shelf-formats"><legend>Image format</legend><label><input type="radio" name="shelf-format" value="landscape" data-action="favorite-shelf#format"><span class="shelf-format-shape landscape" aria-hidden="true"></span><span>Landscape<small>1200 × 630</small></span></label><label><input type="radio" name="shelf-format" value="portrait" checked data-action="favorite-shelf#format"><span class="shelf-format-shape portrait" aria-hidden="true"></span><span>Instagram Story<small>1080 × 1920 · room for stickers</small></span></label></fieldset>
    <% if @shelf_owner %><fieldset class="shelf-customization"><legend>Make the image yours</legend>
      <fieldset class="shelf-layout-cards"><legend>Layout</legend><% [['exhibition', 'Gallery', 'Balanced full covers'], ['collector', 'Feature', 'One lead pick, supporting discoveries'], ['mixtape', 'Mixtape', 'A relaxed cover collage']].each do |value, label, description| %><label><input type="radio" name="layout" aria-label="<%= label %> layout" value="<%= value %>" <%= 'checked' if @image_style['layout'] == value %> data-action="favorite-shelf#customize"><span class="shelf-layout-sample <%= value %>" aria-hidden="true"><% 5.times do %><i></i><% end %></span><strong><%= label %></strong><small><%= description %></small></label><% end %></fieldset>
      <% if @image_style['layout'] == 'reading' %><label for="shelf-layout">Legacy layout</label><select id="shelf-layout" name="layout" data-action="favorite-shelf#customize"><option value="reading" selected>Reading list</option></select><% end %>
      <details class="shelf-advanced"><summary>Advanced appearance</summary><label for="shelf-all-palettes">All palettes</label><select id="shelf-all-palettes" name="shelf-theme" data-action="favorite-shelf#theme"><%= options_for_select(ShelvesHelper::SHELF_THEMES.map { |theme| [shelf_theme_label(theme), theme] }, @theme) %></select><label for="shelf-texture">Background</label><select id="shelf-texture" name="texture" data-action="favorite-shelf#customize"><%= options_for_select([['Clean', 'clean'], ['Paper grain', 'paper'], ['Star field', 'stars']], @image_style['texture']) %></select>
      <label for="shelf-companion">Mascot</label><select id="shelf-companion" name="companion" data-action="favorite-shelf#customize"><%= options_for_select([['Match theme', 'auto'], ['None', 'none'], ['Telly', 'telly'], ['Facet', 'facet'], ['Facet in bat costume', 'bat']], @image_style['companion']) %></select>
      <p>Curated, readable defaults. Your layout, background and companion travel with copied shelf links.</p>
      </details><button type="button" class="shelf-primary" data-action="favorite-shelf#savePresentation">Save appearance</button>
    </fieldset><% end %>
    <% if @shelf_owner %><div class="shelf-publish"><p>Publish a preview after saving selections so social links show your current shelf image.<% if @collection %> A current published preview also makes this shelf eligible for title-page discovery. Editing the shelf pauses discovery until you publish again. Its direct link stays accessible.<% end %></p><button type="button" class="shelf-copy" data-action="favorite-shelf#publishPreview">Publish share preview</button></div><% end %>
    <div class="shelf-share-actions"><button type="button" class="shelf-copy shelf-download" data-action="favorite-shelf#download"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 15v6h16v-6"/></svg><%= @shelf_owner ? "Save & download image" : "Download image" %></button><button type="button" class="shelf-primary" data-action="favorite-shelf#copyLink">Copy shelf link</button><button type="button" class="shelf-copy" data-action="favorite-shelf#copyAltText">Copy image alt text</button></div>
  </section>
  <details class="shelf-alt-text" data-favorite-shelf-target="altTextDetails"><summary>Image alt text</summary><label for="shelf-image-alt-text">Description of your share image</label><textarea id="shelf-image-alt-text" rows="8" readonly data-favorite-shelf-target="altText"></textarea></details>

  <details class="shelf-preview" data-action="toggle->favorite-shelf#previewVisible"><summary>Share image preview</summary><canvas width="1080" height="1920" data-favorite-shelf-target="canvas" aria-label="Shelf share image preview"></canvas></details>
  </details>
</section>
