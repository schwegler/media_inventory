<%= turbo_stream.replace "media_actions_#{@resource.class.name.underscore}_#{@resource.id}" do %>
  <%= render 'shared/media_actions_and_stream', item: @resource %>
<% end %>

<%= turbo_stream.replace "flash-messages" do %>
  <div id="flash-messages">
    <% flash.each do |message_type, message| %>
      <div class="alert alert-<%= message_type %>" role="<%= ['danger', 'alert', 'error', 'warning'].include?(message_type.to_s) ? 'alert' : 'status' %>" data-controller="flash" data-flash-dismiss-after-value="5000">
        <span class="alert-content"><%= message %></span>
        <button type="button" class="alert-dismiss-btn" aria-label="Dismiss notification" data-action="click->flash#dismiss">
          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
