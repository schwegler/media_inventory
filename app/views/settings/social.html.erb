<div class="settings-container">
  <%= render 'sidebar' %>
  <div class="settings-content">
    <h1 class="settings-title">Social connections</h1>
    <p class="text-muted">Connect your accounts, choose what to share, and make each update your own.</p>
    <p class="social-privacy-note">Automatic posts share public additions and reviews only. Private entries, list changes, and updates to what you’ve watched, read, listened to, or played stay in Trove. You can also share any catalog page with its sharing buttons.</p>

    <% if @user.errors.any? %>
      <div role="alert"><%= @user.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="social-connections">
      <% [[:bsky, 'Bluesky'], [:mastodon, 'Mastodon']].each do |platform, name| %>
        <% connected = @user.public_send("#{platform}_access_token").present? %>
        <section class="settings-section social-connection" aria-labelledby="<%= platform %>-heading">
          <h2 id="<%= platform %>-heading" class="section-subtitle"><%= name %></h2>
          <% if connected %>
            <p class="social-connection-status">Connected · <strong><%= platform == :bsky ? @user.bsky_handle.presence || 'Bluesky account' : @user.mastodon_server %></strong></p>
            <%= button_to "Disconnect #{name}", platform == :bsky ? settings_disconnect_bluesky_path : settings_disconnect_mastodon_path, method: :delete, class: "btn btn-outline", data: { turbo_confirm: "Disconnect #{name}? Automatic posting to this account will be turned off." } %>
          <% else %>
            <p class="text-muted">Not connected</p>
            <%= form_tag platform == :bsky ? '/auth/atproto' : '/auth/mastodon', method: :post, data: { turbo: false } do %>
              <% field = platform == :bsky ? :handle : :mastodon_server %>
              <div class="form-group">
                <%= label_tag field, platform == :bsky ? 'Bluesky handle' : 'Mastodon server' %>
                <%= text_field_tag field, nil, class: 'form-control', placeholder: platform == :bsky ? 'username.bsky.social' : 'mastodon.social', required: true, autocapitalize: 'none', spellcheck: false %>
                <small class="text-muted">You’ll authorize Trove on <%= name %>. Your password stays with your provider.</small>
              </div>
              <%= submit_tag "Connect #{name}", class: 'btn btn-primary' %>
            <% end %>
          <% end %>
        </section>
      <% end %>
    </div>

    <%= form_with(model: @user, url: settings_update_social_path, local: true, class: 'settings-form') do |f| %>
      <% [[:bsky, 'Bluesky', 300], [:mastodon, 'Mastodon', 500]].each do |platform, name, limit| %>
        <% connected = @user.public_send("#{platform}_access_token").present? %>
        <section class="settings-section social-preferences">
          <h2 class="section-subtitle"><%= name %> posting preferences</h2>
          <% unless connected %><p class="text-muted">Connect <%= name %> to enable automatic posting. You can prepare templates below.</p><% end %>
          <div class="social-toggles">
            <div><%= f.check_box "#{platform}_post_activity", disabled: !connected %><%= f.label "#{platform}_post_activity", 'Auto-post public additions' %></div>
            <div><%= f.check_box "#{platform}_post_reviews", disabled: !connected %><%= f.label "#{platform}_post_reviews", 'Auto-post public reviews' %></div>
          </div>
          <% [:activity, :review].each do |kind| %>
            <% default = kind == :activity ? 'Just added [title] to my library! [link] #mediatracker' : 'My review of [title]: [review] - [rating]★ [link] #mediatracker' %>
            <div class="form-group social-template" data-controller="social-preview" data-social-preview-default-value="<%= default %>" data-social-preview-limit-value="<%= limit %>">
              <%= f.label "#{platform}_message_#{kind}_template", "#{kind.to_s.capitalize} template" %>
              <%= f.text_area "#{platform}_message_#{kind}_template", class: 'form-control', rows: 3, placeholder: default, data: { social_preview_target: 'input', action: 'input->social-preview#update' } %>
              <small class="text-muted">Use [title], [type], [link], [review], or [rating]. Leave blank for the default.</small>
              <div class="social-template-preview"><strong>Sample preview</strong><p data-social-preview-target="output"></p><small data-social-preview-target="count" aria-live="polite"></small></div>
            </div>
          <% end %>
        </section>
      <% end %>
      <div class="form-actions"><%= f.submit 'Save social preferences', class: 'btn btn-primary' %></div>
    <% end %>
  </div>
</div>
