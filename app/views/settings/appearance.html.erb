<% content_for(:title, 'Appearance') %>
<div class="settings-container">
  <%= render 'sidebar' %>
  <section class="settings-content" data-controller="appearance">
    <h1 class="settings-title">Make Trove yours</h1>
    <p>Your reading room, your way. These preferences follow your account across devices.</p>
    <%= form_with model: @user, url: settings_appearance_path, method: :patch, class: 'settings-form' do |f| %>
      <%= render 'shared/error_messages', object: f.object %>
      <fieldset class="form-field-grid">
        <legend>Your experience</legend>
        <fieldset class="appearance-choices"><legend>Global theme</legend>
          <label class="appearance-choice"><%= f.radio_button :seasonal_theme, 'off' %><span>Standard</span></label>
          <label class="appearance-choice"><%= f.radio_button :seasonal_theme, 'halloween' %><span class="appearance-swatch" style="--swatch: #f49b48" aria-hidden="true"></span><span>Halloween night</span></label>
          <p>Dark plum, orange light and the haunted atmosphere. Available independently of the character invitation. Shelf export themes stay separate.</p>
        </fieldset>
        <fieldset class="appearance-choices"><legend>Base mode</legend>
          <label class="appearance-choice"><%= f.radio_button :theme, 'os' %><span class="appearance-swatch" style="--swatch: #b3b4c0" aria-hidden="true"></span><span>System</span></label>
          <label class="appearance-choice"><%= f.radio_button :theme, 'light' %><span class="appearance-swatch" style="--swatch: #ffffff" aria-hidden="true"></span><span>Light</span></label>
          <label class="appearance-choice"><%= f.radio_button :theme, 'dark' %><span class="appearance-swatch" style="--swatch: #191b21" aria-hidden="true"></span><span>Dark</span></label>
        </fieldset>
        <fieldset class="appearance-choices"><legend>Accent</legend>
          <label class="appearance-choice"><%= f.radio_button :accent_theme, 'halloween' %><span class="appearance-swatch" style="--swatch: #a64b12" aria-hidden="true"></span><span>Halloween · candlelight</span></label>
          <label class="appearance-choice"><%= f.radio_button :accent_theme, 'violet' %><span class="appearance-swatch" style="--swatch: #704cae" aria-hidden="true"></span><span>Editorial violet</span></label>
          <label class="appearance-choice"><%= f.radio_button :accent_theme, 'ink' %><span class="appearance-swatch" style="--swatch: #595462" aria-hidden="true"></span><span>Graphite ink</span></label>
          <label class="appearance-choice"><%= f.radio_button :accent_theme, 'moss' %><span class="appearance-swatch" style="--swatch: #476c50" aria-hidden="true"></span><span>Garden moss</span></label>
        </fieldset>
        <div class="form-group"><%= f.label :content_density, 'Content density' %><%= f.select :content_density, [['Comfortable', 'comfortable'], ['Compact', 'compact']], {}, class: 'form-control' %></div>
        <div class="form-group"><%= f.label :media_layout, 'Media display' %><%= f.select :media_layout, [['Cover gallery', 'covers'], ['Editorial rows', 'rows']], {}, class: 'form-control' %></div>
        <div class="check-field"><%= f.check_box :reduce_effects %><%= f.label :reduce_effects, 'Reduce decorative effects and motion' %></div>
      </fieldset>
      <fieldset class="form-field-grid">
        <legend>Your profile</legend>
        <p>Visible to people visiting your profile. Your profile theme stays within your profile.</p>
        <fieldset class="appearance-choices"><legend>Profile accent</legend>
          <label class="appearance-choice"><%= f.radio_button :profile_accent, 'halloween', data: { action: 'change->appearance#preview', appearance_target: 'accent' } %><span>Halloween · candlelight</span></label>
          <label class="appearance-choice"><%= f.radio_button :profile_accent, 'violet', data: { action: 'change->appearance#preview', appearance_target: 'accent' } %><span class="appearance-swatch" style="--swatch: #704cae" aria-hidden="true"></span><span>Editorial violet</span></label>
          <label class="appearance-choice"><%= f.radio_button :profile_accent, 'ink', data: { action: 'change->appearance#preview', appearance_target: 'accent' } %><span class="appearance-swatch" style="--swatch: #595462" aria-hidden="true"></span><span>Graphite ink</span></label>
          <label class="appearance-choice"><%= f.radio_button :profile_accent, 'moss', data: { action: 'change->appearance#preview', appearance_target: 'accent' } %><span class="appearance-swatch" style="--swatch: #476c50" aria-hidden="true"></span><span>Garden moss</span></label>
        </fieldset>
        <fieldset class="appearance-choices"><legend>Header treatment</legend>
          <label class="appearance-choice"><%= f.radio_button :profile_header, 'halloween', data: { action: 'change->appearance#preview', appearance_target: 'header' } %><span>Harvest moon</span></label>
          <label class="appearance-choice"><%= f.radio_button :profile_header, 'linen', data: { action: 'change->appearance#preview', appearance_target: 'header' } %><span class="appearance-swatch" style="--swatch: #e5e1d7" aria-hidden="true"></span><span>Linen</span></label>
          <label class="appearance-choice"><%= f.radio_button :profile_header, 'solid', data: { action: 'change->appearance#preview', appearance_target: 'header' } %><span class="appearance-swatch" style="--swatch: #65418f" aria-hidden="true"></span><span>Solid</span></label>
          <label class="appearance-choice"><%= f.radio_button :profile_header, 'minimal', data: { action: 'change->appearance#preview', appearance_target: 'header' } %><span class="appearance-swatch" style="--swatch: #f7f7fa" aria-hidden="true"></span><span>Minimal</span></label>
        </fieldset>
        <div class="profile-preview profile-page" data-appearance-target="preview" data-profile-accent="<%= @user.profile_accent %>" data-profile-header="<%= @user.profile_header %>" aria-label="Profile theme preview">
          <div class="banner-placeholder"></div>
          <div class="profile-preview-body"><%= user_avatar_tag(@user, size: 48) %><div><strong><%= @user.name %></strong><p>A collection of things you love.</p></div></div>
        </div>
        <p class="form-help">Upload a banner and edit your bio in <%= link_to 'Basic Information', settings_basic_info_path %>.</p>
      </fieldset>
      <details class="companion-note"><summary>A note from your library companion</summary><div><%= render 'shared/quiet_companion' %><p>A shelf can be a work in progress. Save what you love, change your mind, and leave room for the next discovery.</p></div></details>
      <div class="form-actions"><%= f.submit 'Save preferences', class: 'btn btn-primary', data: { turbo_submits_with: 'Saving…' } %><%= link_to 'View profile', @user, class: 'btn btn-secondary' %></div>
    <% end %>
  </section>
</div>
