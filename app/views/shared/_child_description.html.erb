<% if strip_tags(item.summary.to_s).squish.present? %>
  <section class="child-description" aria-label="<%= item.is_a?(ComicIssue) ? 'Issue' : 'Episode' %> description">
    <h3>Description</h3>
    <% if strip_tags(item.summary).length > 420 %>
      <details class="child-description-disclosure">
        <summary><span class="child-description-more">Read full description</span><span class="child-description-less">Show less</span></summary>
        <div class="child-description-prose"><%= child_description(item.summary) %></div>
      </details>
      <p class="child-description-preview"><%= truncate(strip_tags(item.summary.gsub(/<\/(?:p|li|blockquote|h[2-4])>|<br\s*\/?\s*>/i, ' ')).squish, length: 420, separator: ' ') %></p>
    <% else %>
      <div class="child-description-prose"><%= child_description(item.summary) %></div>
    <% end %>
  </section>
<% end %>
