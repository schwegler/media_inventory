<% groups = child_credit_groups(item) %>
<% if groups.any? %>
  <section class="child-detail-credits" aria-label="People and credits">
    <h2>People &amp; credits</h2>
    <dl>
      <% groups.each do |role, credits| %>
        <div>
          <dt><%= role %></dt>
          <dd><%= credits %></dd>
        </div>
      <% end %>
    </dl>
  </section>
<% end %>
