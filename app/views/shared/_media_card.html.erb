<% media_title = media_item.try(:title) || media_item.try(:name) || 'Media' %>
<% card = media_card_presentation(media_item) %>
<% ratings = item_card_ratings(media_item) %>
<div class="card-2026" data-media-kind="<%= media_item.class.name %>">
  <div class="card-2026-cover">
    <% if media_item.respond_to?(:stored_cover_url) && media_item.stored_cover_url.present? %>
      <%= image_tag media_item.stored_cover_url, alt: "#{media_title} cover", loading: "lazy", decoding: "async" %>
    <% else %>
      <span class="fallback-emoji">
        <%= case media_item.class.name
            when 'Movie' then '🎬'
            when 'Album' then '💿'
            when 'Comic' then '📚'
            when 'TvShow' then '📺'
            when 'VideoGame' then '🎮'
            else '📦'
            end %>
      </span>
    <% end %>
  </div>
  <div class="card-2026-content">
    <h3 class="card-2026-title" title="<%= media_title %>"><%= link_to card.title, media_item, data: { turbo_frame: "_top" } %></h3>

    <% if card.byline %>
      <p class="card-2026-byline" title="<%= card.byline.label %> <%= card.byline.full %>">
        <span class="visually-hidden"><%= card.byline.label %></span>
        <%= card.byline.value %>
      </p>
    <% end %>

    <% card.credits.each do |credit| %>
      <p class="card-2026-meta card-2026-credit" title="<%= credit.label %> <%= credit.full %>">
        <span class="card-2026-credit-label"><%= credit.label %></span>
        <%= credit.value %>
      </p>
    <% end %>

    <% if card.facts.any? %>
      <p class="card-2026-meta card-2026-facts">
        <% card.facts.each do |fact| %><span class="<%= 'card-2026-year' if fact == card.facts.first && fact.to_s.match?(/\A\d{4}\z/) %>"><%= fact %></span><% end %>
      </p>
    <% end %>

    <%= render 'shared/card_ratings', user_rating: ratings[:user_rating], avg_rating: ratings[:avg_rating] %>
  </div>
</div>
