<% media_title = media_item.try(:title) || media_item.try(:name) || 'Media' %>
<% card = media_card_presentation(media_item) %>
<% year = media_item.try(:release_year).presence || media_title.to_s[MediaCardHelper::TRAILING_YEAR, 1] %>
<% ratings = item_card_ratings(media_item) %>
<% user_rating = ratings[:user_rating] %>
<% avg_rating = ratings[:avg_rating] %>
<div class="card-2026" data-media-kind="<%= media_item.class.name %>">
  <div class="card-2026-cover">
    <% if media_item.respond_to?(:stored_cover_url) && media_item.stored_cover_url.present? %>
      <%= media_cover_image media_item, alt: "#{media_title} cover", loading: "lazy", decoding: "async" %>
    <% else %>
      <span class="fallback-emoji">
        <%= case media_item.class.name
            when 'Movie' then ui_icon('film')
            when 'Album' then ui_icon('disc')
            when 'Comic' then ui_icon('library')
            when 'TvShow' then ui_icon('tv')
            when 'VideoGame' then ui_icon('gamepad')
            when 'Book' then ui_icon('book')
            when 'WrestlingEvent' then ui_icon('wrestling')
            else ui_icon('archive')
            end %>
      </span>
    <% end %>
  </div>
  <div class="card-2026-content">
    <div class="card-2026-heading">
      <h3 class="card-2026-title"><%= link_to card.title, media_item, data: { turbo_frame: "_top" }, title: media_title %></h3>
      <% if year.present? %>
        <span class="card-2026-year"><%= year %></span>
      <% end %>
    </div>
    <% creator = card.byline %>
    <% if creator.present? %>
      <p class="card-2026-meta card-2026-creator" title="<%= creator.label %> <%= creator.full %>"><%= creator.value %></p>
    <% end %>
    <% if @personal_library && (library = @libraries&.[](media_item.id)) %>
      <div class="library-card-state">
        <% if (progress = library_progress(media_item, library)) %>
          <span><%= progress[0] %> / <%= progress[1] %> <%= progress[2] %></span>
          <progress value="<%= progress[0] %>" max="<%= progress[1] %>" aria-label="<%= progress[2] %>"></progress>
        <% else %>
          <span><%= library.consumed? ? library_config(media_item.class)[:finished] : (library.in_backlog? ? library_config(media_item.class)[:queue] : library_config(media_item.class)[:unfinished]) %></span>
        <% end %>
        <%= link_to 'Update', polymorphic_path(media_item), aria: { label: "Update #{media_title}" } %>
      </div>
    <% end %>
    <%= render 'shared/card_ratings', user_rating: user_rating, avg_rating: avg_rating %>
  </div>
</div>
