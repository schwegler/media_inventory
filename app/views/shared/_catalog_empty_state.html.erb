<div class="home-empty-state">
  <h2>No <%= media_name %> yet</h2>
  <p>This shelf is waiting for its first favorite.</p>
  <% if logged_in? %>
    <%= link_to "Add #{article} #{singular_name}", new_item_path, class: "sleek-btn sleek-btn-primary", data: { turbo_frame: "_top" } %>
  <% else %>
    <%= link_to "Create your library", signup_path, class: "sleek-btn sleek-btn-primary", data: { turbo_frame: "_top" } %>
  <% end %>
</div>
