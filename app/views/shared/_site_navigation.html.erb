  <% unless hotwire_native_app? %>
  <div class="header-shell" data-controller="floating-header">
  <header class="app-header" data-controller="mobile-menu header-search" data-floating-header-target="header">
    <nav class="app-nav">
      <div class="nav-brand">
        <%= link_to root_path, class: 'brand-link' do %>
          <%= image_tag 'brand/trove_rounded_app_icon.png', class: 'brand-logo', width: 36, height: 36, alt: '' %>
          <span class="brand-text">trove</span>
        <% end %>
        <a class="brand-companion" href="https://tacobout.online/">from taco ’bout it</a>
      </div>

        <nav class="workspace-primary-nav" aria-label="Primary navigation">
          <%= link_to 'Home', root_path, aria: { current: controller_name == 'landing' ? 'page' : nil } %>
          <details class="browse-navigation" data-controller="disclosure-menu">
            <summary>Browse</summary>
            <div class="browse-navigation-links">
              <% MediaLayoutHelper::CATALOGS.each do |type, (label, _singular, _icon)| %>
                <% active = !@personal_library && [type.underscore.pluralize, { 'TvShow' => 'tv_episodes', 'Comic' => 'comic_issues' }[type]].include?(controller_name) %>
                <%= link_to label, polymorphic_path(type.constantize), aria: { current: active ? 'page' : nil } %>
              <% end %>
              <%= link_to 'People & Metadata', metadata_entities_path %>
            </div>
          </details>
          <% if logged_in? %>
            <%= link_to 'My library', owner_library_path, aria: { current: owner_library_current? ? 'page' : nil } %>
          <% end %>
          <%= link_to 'Community', users_path, aria: { current: controller_name == 'users' && action_name == 'index' ? 'page' : nil } %>
          <% if logged_in? %><%= link_to 'Profile', current_user, aria: { current: current_user?(@user) && params[:tab].blank? && controller_name == 'users' ? 'page' : nil } %><% end %>
        </nav>
        <div class="header-search-anchor">
        <div id="header-search-panel" class="combined-search" data-header-search-target="panel"><%= render 'shared/header_search' %></div>
        <button class="combined-search-toggle btn btn-ghost" type="button" data-action="header-search#toggle" aria-label="Search Trove and supported catalogs" aria-controls="header-search-panel" aria-expanded="false" data-header-search-target="button"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m16 16 4 4"/></svg></button>
        </div>
      <%= render 'shared/appearance_menu' %>
      <div class="nav-user-section desktop-nav">
        <a class="blog-nav-link" href="https://tacobout.online/">Blog</a>
        <% if logged_in? %>
          <div class="nav-notifications">
            <%= link_to notifications_path, class: "notification-bell", aria: { label: "Notifications" } do %>
              <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
              <%# Use .size instead of .count to utilize loaded collection if present and prevent redundant database queries %>
              <% unread_count = current_user.notifications.unread.size %>
              <% if unread_count > 0 %>
                <span style="position: absolute; top: -5px; right: -5px; background: #ef4444; color: white; font-size: 10px; font-weight: bold; width: 16px; height: 16px; display: flex; align-items: center; justify-content: center; border-radius: 50%;"><%= unread_count > 9 ? '9+' : unread_count %></span>
              <% end %>
            <% end %>
          </div>

          <div class="nav-dropdown" data-controller="dropdown">
            <button class="nav-user-info sleek-btn usr-btn dropdown-toggle" type="button" aria-label="Account menu" data-action="click->dropdown#toggle" data-dropdown-target="button" aria-haspopup="true" aria-expanded="false">
              <%= user_avatar_tag(current_user, size: 24) %>
              <span class="nav-username" title="<%= current_user.name %>"><%= current_user.name.upcase %></span>
              <svg class="dropdown-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="dropdown-menu user-dropdown-menu" data-dropdown-target="menu" role="menu">
              <%= link_to "Profile", current_user, class: "dropdown-item", role: "menuitem" %>
              <%= link_to "People & Metadata", metadata_entities_path, class: "dropdown-item", role: "menuitem" %>
              <%= link_to "My Shelf", my_shelf_path, class: "dropdown-item", role: "menuitem" %>
              <%= link_to "Settings", settings_path, class: "dropdown-item", role: "menuitem" %>
              <% if current_user.admin? %>
                <%= link_to "Admin", admin_root_path, class: "dropdown-item", role: "menuitem" %>
              <% end %>
              <div class="dropdown-divider"></div>
              <%= button_to "Sign Out", logout_path, method: :delete, class: "dropdown-item dropdown-logout-btn", role: "menuitem", form_class: "dropdown-logout-form" %>
            </div>
          </div>

          <div class="nav-dropdown" data-controller="dropdown">
            <button class="sleek-btn sleek-btn-success btn-log" type="button" data-action="click->dropdown#toggle" data-dropdown-target="button" aria-haspopup="true" aria-expanded="false" aria-label="Toggle log menu">
              <span>+ Add to library</span>
              <svg class="dropdown-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </button>
            <div class="dropdown-menu" data-dropdown-target="menu" style="display: none;" role="menu">
              <%= link_to safe_join([ui_icon('film'), " Log Movie"]), new_movie_path, class: "dropdown-item", role: "menuitem", data: { turbo_frame: "modal" } %>
              <%= link_to safe_join([ui_icon('disc'), " Log Album"]), new_album_path, class: "dropdown-item", role: "menuitem", data: { turbo_frame: "modal" } %>
              <%= link_to safe_join([ui_icon('library'), " Log Comic"]), new_comic_path, class: "dropdown-item", role: "menuitem", data: { turbo_frame: "modal" } %>
              <%= link_to safe_join([ui_icon('tv'), " Log TV Show"]), new_tv_show_path, class: "dropdown-item", role: "menuitem", data: { turbo_frame: "modal" } %>
              <%= link_to safe_join([ui_icon('gamepad'), " Log Video Game"]), new_video_game_path, class: "dropdown-item", role: "menuitem", data: { turbo_frame: "modal" } %>
              <%= link_to safe_join([ui_icon('book'), " Log Book"]), new_book_path, class: "dropdown-item", role: "menuitem", data: { turbo_frame: "modal" } %>
            </div>
          </div>
        <% else %>
          <%= link_to "Log in", login_path, class: 'sleek-btn sleek-btn-secondary' %>
        <% end %>
      </div>

      <button class="mobile-menu-btn" type="button" data-action="click->mobile-menu#toggle" aria-label="Toggle navigation" aria-controls="mobile-navigation" aria-expanded="false" data-mobile-menu-target="button">
        <svg class="menu-icon" data-mobile-menu-target="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="close-icon hidden" data-mobile-menu-target="closeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </nav>
    <nav class="library-nav desktop-nav" aria-label="Library">
      <ul class="nav-links">
        <li><%= link_to "Movies", movies_path, aria: { current: !@personal_library && controller_name == "movies" ? "page" : nil } %></li>
        <li><%= link_to "Albums", albums_path, aria: { current: !@personal_library && controller_name == "albums" ? "page" : nil } %></li>
        <li><%= link_to "Comics", comics_path, aria: { current: !@personal_library && %w[comics comic_issues].include?(controller_name) ? "page" : nil } %></li>
        <li><%= link_to "TV shows", tv_shows_path, aria: { current: !@personal_library && %w[tv_shows tv_episodes].include?(controller_name) ? "page" : nil } %></li>
        <li><%= link_to "Games", video_games_path, aria: { current: !@personal_library && controller_name == "video_games" ? "page" : nil } %></li>
        <li><%= link_to "Books", books_path, aria: { current: !@personal_library && controller_name == "books" ? "page" : nil } %></li>
        <% if logged_in? %>
          <li><%= link_to "Members", users_path, aria: { current: controller_name == "users" ? "page" : nil } %></li>
        <% end %>

      </ul>

          <form action="<%= search_path %>" method="get" class="global-search-form" data-turbo-action="advance">
            <input type="search" name="q" class="global-search-input" placeholder="Search Trove and catalogs" aria-label="Search Trove and supported catalogs" value="<%= params[:q] %>" autocomplete="off">
            <button type="submit" class="global-search-btn" aria-label="Submit search">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </button>
          </form>
    </nav>

    <div id="mobile-navigation" class="mobile-nav-panel" role="navigation" aria-label="Main navigation" data-mobile-menu-target="menu" data-action="click->mobile-menu#navigate">
      <div class="mobile-nav-search">
        <form action="<%= search_path %>" method="get" class="global-search-form" data-turbo-action="advance">
          <input type="text" name="q" class="global-search-input" placeholder="Search Trove..." aria-label="Search" value="<%= params[:q] %>" autocomplete="off">
          <button type="submit" class="global-search-btn" aria-label="Submit search">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
        </form>
      </div>
      <ul class="mobile-nav-links">
        <li><%= link_to "Home", root_path %></li>
        <% if logged_in? %><li><%= link_to "My library", owner_library_path, aria: { current: owner_library_current? ? "page" : nil } %></li><% end %>
        <li><%= link_to "People & Metadata", metadata_entities_path %></li>
        <li><%= link_to "Movies", movies_path, aria: { current: !@personal_library && controller_name == "movies" ? "page" : nil } %></li>
        <li><%= link_to "Albums", albums_path, aria: { current: !@personal_library && controller_name == "albums" ? "page" : nil } %></li>
        <li><%= link_to "Comics", comics_path, aria: { current: !@personal_library && %w[comics comic_issues].include?(controller_name) ? "page" : nil } %></li>
        <li><%= link_to "TV shows", tv_shows_path, aria: { current: !@personal_library && %w[tv_shows tv_episodes].include?(controller_name) ? "page" : nil } %></li>
        <li><%= link_to "Games", video_games_path, aria: { current: !@personal_library && controller_name == "video_games" ? "page" : nil } %></li>
        <li><%= link_to "Books", books_path, aria: { current: !@personal_library && controller_name == "books" ? "page" : nil } %></li>
        <% if logged_in? %>
          <li><%= link_to "Members", users_path, aria: { current: controller_name == "users" ? "page" : nil } %></li>
        <% end %>
      </ul>
      <a class="blog-nav-link" href="https://tacobout.online/">Blog — taco ’bout it</a>
      <div class="mobile-nav-user-section">
        <% if logged_in? %>
          <div class="mobile-user-profile">
            <%= user_avatar_tag(current_user, size: 48) %>
            <div class="mobile-user-info">
              <span class="nav-username" title="<%= current_user.name %>"><%= current_user.name.upcase %></span>
              <div class="mobile-user-links">
                <%= link_to "Profile", current_user, class: "mobile-link" %>
                <%= link_to "My Shelf", my_shelf_path, class: "mobile-link" %>
                <%= link_to "Settings", settings_path, class: "mobile-link" %>
                <% if current_user.admin? %>
                  <%= link_to "Admin", admin_root_path, class: "mobile-link" %>
                <% end %>
                <%= link_to notifications_path, class: "mobile-link" do %>
                  Notifications
                  <% unread_count = current_user.notifications.unread.size %>
                  <% if unread_count > 0 %>
                    <span style="background: #ef4444; color: white; font-size: 10px; font-weight: bold; padding: 2px 6px; border-radius: 10px; margin-left: 4px;"><%= unread_count %></span>
                  <% end %>
                <% end %>
                <%= button_to "Sign Out", logout_path, method: :delete, class: "mobile-link mobile-logout-btn", form_class: "dropdown-logout-form" %>
              </div>
            </div>
          </div>
          <div class="mobile-log-actions">
            <h4 class="mobile-log-header">LOG NEW ITEM</h4>
            <%= link_to safe_join([ui_icon('film'), " Log Movie"]), new_movie_path, class: "mobile-log-btn", data: { turbo_frame: "modal" } %>
            <%= link_to safe_join([ui_icon('disc'), " Log Album"]), new_album_path, class: "mobile-log-btn", data: { turbo_frame: "modal" } %>
            <%= link_to safe_join([ui_icon('library'), " Log Comic"]), new_comic_path, class: "mobile-log-btn", data: { turbo_frame: "modal" } %>
            <%= link_to safe_join([ui_icon('tv'), " Log TV Show"]), new_tv_show_path, class: "mobile-log-btn", data: { turbo_frame: "modal" } %>
            <%= link_to safe_join([ui_icon('gamepad'), " Log Video Game"]), new_video_game_path, class: "mobile-log-btn", data: { turbo_frame: "modal" } %>
            <%= link_to safe_join([ui_icon('book'), " Log Book"]), new_book_path, class: "mobile-log-btn", data: { turbo_frame: "modal" } %>
          </div>
        <% else %>
          <div class="mobile-auth-actions">
            <%= link_to "Log in", login_path, class: 'btn btn-primary' %>
          </div>
        <% end %>
      </div>
    </div>
  </header>
  </div>
  <% end %>

<% if hotwire_native_app? %>
  <nav class="native-tools container" aria-label="Library tools">
    <%= link_to 'Search', search_path %>
    <%= link_to 'Browse', movies_path %>
    <% if logged_in? %>
      <%= link_to 'My library', owner_library_path, aria: { current: owner_library_current? ? 'page' : nil } %>
      <%= link_to 'Settings', settings_path %>
    <% end %>
    <details><summary>Categories</summary><div class="native-categories">
      <% [['Movies', movies_path], ['Albums', albums_path], ['Comics', comics_path], ['TV shows', tv_shows_path], ['Games', video_games_path], ['Books', books_path]].each do |label, path| %>
        <%= link_to label, path %>
      <% end %>
    </div></details>
  </nav>
<% end %>


<%= render 'shared/appearance_menu' if hotwire_native_app? %>
