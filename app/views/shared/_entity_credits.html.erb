<%
  fields = MetadataEntitySync::FIELDS.fetch(item.class.name, {})
  displayed_roles = media_metadata(item).filter_map do |_, _, attribute|
    role = fields[attribute]
    role unless %w[Genre Platform].include?(role)
  end
  credits = item.metadata_credits.reject { |credit| displayed_roles.include?(credit.role) }
                .sort_by { |credit| [credit.position, credit.id] }
%>
<% if credits.any? %>
  <section class="media-description entity-credits" aria-label="Linked credits">
    <h2>People &amp; Metadata</h2>
    <dl class="media-description-facts">
      <% credits.group_by(&:role).each do |role, entries| %>
        <div class="media-description-row"><dt><%= role %></dt><dd><%= entity_credit_links(entries) %></dd></div>
      <% end %>
    </dl>
  </section>
<% end %>
