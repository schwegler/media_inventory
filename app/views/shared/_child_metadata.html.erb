<% if item.metadata_details.present? %>
  <section class="child-metadata media-description" aria-label="<%= item.is_a?(ComicIssue) ? 'Issue' : 'Episode' %> details">
    <h3><%= item.is_a?(ComicIssue) ? 'Issue' : 'Episode' %> details</h3>
    <dl class="media-description-facts">
      <% item.metadata_details.each do |label, value| %>
        <% text = value.is_a?(Array) ? value.join(', ') : value %>
        <div class="media-description-row"><dt><%= label.to_s.humanize %></dt><dd>
          <% if text.to_s.length > 240 %><details><summary>Show <%= label.to_s.humanize.downcase %></summary><%= source_link_or_text(text) %></details><% else %><%= source_link_or_text(text) %><% end %>
        </dd></div>
      <% end %>
    </dl>
  </section>
<% end %>
<%= render 'shared/child_credits', item: item if local_assigns.fetch(:show_credits, true) %>
