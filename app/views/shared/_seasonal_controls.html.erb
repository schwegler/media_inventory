<% if (season = active_season) %>
  <fieldset class="seasonal-controls" data-halloween-target="controls"><legend>Seasonal theme</legend>
    <div class="appearance-options"><button type="button" data-halloween-target="on" data-action="halloween#apply" aria-pressed="false"><%= season['label'] %></button><button type="button" data-halloween-target="off" data-action="halloween#undo" aria-pressed="true">Off</button></div>
    <div data-halloween-target="notice" hidden><p data-halloween-target="message"></p><button type="button" data-halloween-target="undo" data-action="halloween#undo">Undo Halloween</button></div>
    <button type="button" data-halloween-target="pause" data-action="halloween#pause" aria-pressed="false">Pause motion</button>
    <button type="button" data-halloween-target="atmosphere" data-action="halloween#atmosphere" aria-pressed="false">Hide atmosphere</button>
    <button type="button" data-action="halloween#resetChoice">Restore Halloween character</button>
  </fieldset>
<% end %>
