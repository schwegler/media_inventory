<% content_for(:title, title) %>
<% content_for(:meta_description, "#{description} of #{parent.title}") %>
<% content_for(:item_detail, 'true') %>
<% content_for(:media_workspace, 'true') %>
<% stats = community_stats_for(item) %>
<% date = Date.iso8601(date) if date.is_a?(String) && date.match?(/\A\d{4}-\d{2}-\d{2}\z/) && Date.valid_date?(*date.split('-').map(&:to_i)) %>
<% cover = item.stored_cover_url.presence || parent.stored_cover_url %>
<article class="media-detail media-child-detail" data-media-kind="<%= item.class.name %>">
  <%= link_to "← Back to #{parent.title}", series_return_path(item, parent), class: 'media-back-link' %>
  <% neighbors = SeriesNeighbors.call(item) %>
  <nav class="child-sequence-navigation" aria-label="<%= item.is_a?(TvEpisode) ? 'Episode' : 'Issue' %> navigation">
    <%= link_to '← Previous', neighbors[:previous], class: 'sleek-btn sleek-btn-secondary', aria: { label: "Previous #{item.is_a?(TvEpisode) ? 'episode' : 'issue'} of #{parent.title}" } if neighbors[:previous] %>
    <%= link_to 'Next →', neighbors[:next], class: 'sleek-btn sleek-btn-secondary', aria: { label: "Next #{item.is_a?(TvEpisode) ? 'episode' : 'issue'} of #{parent.title}" } if neighbors[:next] %>
  </nav>
  <header class="media-overview">
    <div class="media-cover">
      <% if cover.present? %><%= artwork_lightbox("#{cover}?size=original", "#{title} cover") do %><%= media_cover_image(item.stored_cover_url.present? ? item : parent, alt: "#{title} cover", sizes: "180px") %><% end %><% else %><div class="artwork-fallback">No cover yet</div><% end %>
    </div>
    <div class="media-identity">
      <h1><%= title %></h1>
      <p class="media-child-subtitle"><%= description %> of <%= link_to parent.title, parent %><% if date.present? %> · <%= date.respond_to?(:strftime) ? date.strftime('%b %-d, %Y') : date %><% end %></p>
      <details class="media-share"><summary>Share this title</summary><%= render 'shared/item_sharing', item: item %></details>
    </div>
    <aside class="media-overview-stats" aria-label="Community summary">
      <div><strong><%= stats[:avg_rating] ? "#{stats[:avg_rating]} ★" : '—' %></strong><span>Average rating</span></div>
      <div><strong><%= stats[:watchers].size %></strong><span><%= media_audience(item) %></span></div>
      <div><strong><%= item.likes.size %></strong><span>Likes</span></div>
    </aside>
  </header>
  <div id="<%= item.model_name.param_key %>_tracking_<%= item.id %>"><%= render tracking, comic: parent, tv_show: parent %></div>
  <div class="child-detail-content">
    <section class="child-detail-synopsis" aria-label="Synopsis"><%= render 'shared/child_description', item: item %></section>
    <aside class="child-detail-facts" aria-label="Title details"><%= render 'shared/child_metadata', item: item, show_credits: false %></aside>
  </div>
  <%= render 'shared/child_credits', item: item %>
  <section class="child-detail-community">
    <div class="child-community-heading"><h2>Community Activity</h2><%= render 'likes/like_button', item: item %></div>
    <%= render 'shared/comments_box', matching_item: item %>
  </section>
  <%= render 'shared/metadata_refresh', item: parent %>
</article>
