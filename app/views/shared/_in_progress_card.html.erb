<%# Local variables: in_progress, profile_owner (optional) %>
<%
  profile_owner = local_assigns.fetch(:profile_owner, logged_in? && current_user?(@user || in_progress.library_item&.user))
  series = in_progress.series
  next_item = in_progress.next_item
  is_tv = in_progress.tv_show?
  completed = in_progress.completed_count
  total = in_progress.total_count
  percent = in_progress.percent

  series_title = series.title
  series_path = polymorphic_path(series)
  series_cover = series.stored_cover_url

  if is_tv
    tag_label = "TV Show"
    fallback_icon = ui_icon('tv')
    next_label = next_item.episode_code
    next_title = next_item.name.presence || next_item.episode_label
    next_path = tv_episode_path(next_item)
    next_thumb = next_item.stored_cover_url.presence || series_cover
    release_date = media_release_date(next_item)
    past_verb = "Aired"
    log_url = toggle_watched_tv_episode_path(next_item)
    param_key = :tv_episode
    action_verb = "Watch"
    units_label = "episodes"
  else
    tag_label = "Comic"
    fallback_icon = ui_icon('library')
    next_label = next_item.issue_number.present? ? "##{next_item.issue_number}" : "Issue"
    next_title = next_item.title.presence || (next_item.issue_number.present? ? "Issue ##{next_item.issue_number}" : "Next issue")
    next_path = comic_issue_path(next_item)
    next_thumb = next_item.stored_cover_url.presence || series_cover
    release_date = media_release_date(next_item)
    past_verb = "Released"
    log_url = toggle_read_comic_issue_path(next_item)
    param_key = :comic_issue
    action_verb = "Read"
    units_label = "issues"
  end
  upcoming = release_date.present? && release_date > Date.current
  next_meta = if release_date.blank?
                "Release date unknown"
              elsif upcoming
                "Expected #{release_date}"
              else
                "#{past_verb} #{release_date}"
              end
%>

<article id="<%= in_progress.dom_id %>" class="in-progress-card" data-controller="tracking-focus" data-action="turbo:submit-start->tracking-focus#remember turbo:before-stream-render@document->tracking-focus#retain" data-media-type="<%= in_progress.media_type %>">
  <div class="in-progress-header">
    <div class="in-progress-cover">
      <% if series_cover.present? %>
        <%= media_cover_image series, alt: "", sizes: "(max-width: 580px) 90px, 144px", width: 144, height: 216 %>
      <% else %>
        <span class="fallback-emoji"><%= fallback_icon %></span>
      <% end %>
    </div>

    <div class="in-progress-series-info">
      <div class="in-progress-tag-row">
        <span class="in-progress-series-tag"><%= tag_label %></span>
        <% if in_progress.pass&.rewatch? %>
          <span class="in-progress-pass-badge"><%= is_tv ? "Re-watch" : "Re-read" %> #<%= in_progress.pass.number - 1 %></span>
        <% end %>

      </div>
      <h3 class="in-progress-series-title">
        <%= link_to series_title, series_path %>
      </h3>


    </div>
    <% if profile_owner && in_progress.pass %>
      <details class="tracking-options" data-controller="disclosure-menu">
        <summary aria-label="Tracking options for <%= series_title %>" title="Tracking options"><%= ui_icon("more-horizontal") %><span class="tracking-options-label">Tracking</span></summary>
        <div class="tracking-options-menu">
          <p>Your progress is kept when you dismiss a series.</p>
          <%= button_to "Dismiss", dismiss_consumption_pass_path(in_progress.pass), method: :patch, class: "in-progress-dismiss", form_class: "in-progress-dismiss-form", aria: { label: "Dismiss #{series_title} from In progress" } %>
        </div>
      </details>
    <% end %>
  </div>

  <div class="in-progress-next">
    <div class="in-progress-next-header">
      <span class="in-progress-next-badge"><%= upcoming ? "Upcoming" : "Up Next" %></span>
      <% if next_meta.present? %>
        <span class="in-progress-next-meta"><%= next_meta %></span>
      <% end %>
    </div>

    <div class="in-progress-next-row">
      <% if next_thumb.present? %>
        <div class="in-progress-next-thumb">
          <%= media_cover_image(next_item.stored_cover_url.present? ? next_item : series, alt: "", sizes: "48px", width: 48, height: 48) %>
        </div>
      <% end %>

      <div class="in-progress-next-details">
        <div class="in-progress-next-title">
          <span class="in-progress-next-num"><%= next_label %></span>
          <%= link_to next_title, next_path, class: 'in-progress-next-link', title: next_title %>
        </div>

      <div class="in-progress-progress">
        <div class="in-progress-progress-header">
          <span class="in-progress-progress-counts"><%= completed %> / <%= total %> <%= units_label %></span>
          <span class="in-progress-progress-percent"><%= percent %>%</span>
        </div>
        <div class="in-progress-progress-bar" role="progressbar" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= series_title %> progress">
          <div class="in-progress-progress-fill" style="width: <%= [percent, 100].min %>%;"></div>
        </div>
      </div>
        <% if profile_owner %>
          <% if upcoming %><details class="in-progress-early"><summary>Log an early <%= is_tv ? "watch" : "read" %></summary><p>This release is expected in the future. Log it only if you’ve already finished it.</p><% end %>
          <%= form_with url: log_url, method: :patch, class: 'in-progress-log-form' do |f| %>
            <%= f.hidden_field "#{param_key}[consumed]", value: true, id: nil %>
            <%= f.hidden_field "#{param_key}[consumed_at]", value: Date.current, id: nil %>
            <%= hidden_field_tag :in_progress, true, id: nil %>

            <div class="in-progress-form-actions">
              <%= f.select "#{param_key}[rating]", [
                ["Rating", ""],
                ["½ ★", "0.5"],
                ["★", "1.0"],
                ["★½", "1.5"],
                ["★★", "2.0"],
                ["★★½", "2.5"],
                ["★★★", "3.0"],
                ["★★★½", "3.5"],
                ["★★★★", "4.0"],
                ["★★★★½", "4.5"],
                ["★★★★★", "5.0"]
              ], {}, { id: "#{in_progress.dom_id}_rating", class: 'in-progress-rating-select', aria: { label: "Rating for #{series_title} · #{next_label} · #{next_title}" } } %>

              <%= f.button type: :submit, class: 'sleek-btn sleek-btn-primary in-progress-log-btn', data: { tracking_primary: true }, aria: { label: "#{action_verb} #{series_title} · #{next_label} · #{next_title}" } do %>
                <%= is_tv ? "Mark watched" : "Mark read" %>
              <% end %>
            </div>
          <% end %>
          <% if upcoming %></details><% end %>
        <% end %>
      </div>
    </div>
  </div>
</article>
