<% apple_label = { 'Album' => 'View on Apple Music', 'Book' => 'View on Apple Books', 'Comic' => 'View on Apple Books', 'VideoGame' => 'View on Apple Arcade' }.fetch(item.class.name, 'View on Apple TV') %>
  <div class="streaming-links-box">
    <h3 class="streaming-links-title">
      Find this title
    </h3>

    <div class="streaming-buttons-row">
      <% if item.external_url.present? %>
        <% link_label, icon_name = if item.external_url.include?('itunes.apple.com') || item.external_url.include?('music.apple.com')
                                     [apple_label, 'disc']
                                   elsif item.external_url.include?('openlibrary.org')
                                     ["Borrow on Open Library", 'book']
                                   elsif item.external_url.include?('tvmaze.com')
                                     ["View on TVmaze", 'tv']
                                   elsif item.external_url.include?('steampowered.com') || item.external_url.include?('steamcommunity.com')
                                     ["View on Steam", 'gamepad']
                                   else
                                     ["View Official Source", 'globe']
                                   end %>
        <%= link_to item.external_url, target: "_blank", rel: "noopener", class: "btn btn-stream-source" do %>
          <span class="media-source-icon" aria-hidden="true"><%= ui_icon(icon_name) %></span>
          <span class="media-source-label"><%= link_label %></span>
        <% end %>
      <% end %>

      <% if ['Movie', 'TvShow'].include?(item.class.name) %>
        <%= link_to "https://www.justwatch.com/us/search?q=#{CGI.escape(item.title)}", target: "_blank", rel: "noopener", class: "btn btn-stream-search" do %>
          <span class="media-source-icon" aria-hidden="true"><%= ui_icon('film') %></span>
          <span class="media-source-label">Search JustWatch</span>
        <% end %>
      <% end %>

      <% if item.class.name == 'VideoGame' %>
        <%= link_to "https://howlongtobeat.com/?q=#{CGI.escape(item.title)}", target: "_blank", rel: "noopener", class: "btn btn-stream-search" do %>
          <span class="media-source-icon" aria-hidden="true"><%= ui_icon('gamepad') %></span>
          <span class="media-source-label">Search HowLongToBeat</span>
        <% end %>
      <% end %>

      <% if item.class.name == 'Comic' %>
        <%= link_to "https://www.goodreads.com/search?q=#{CGI.escape(item.title)}", target: "_blank", rel: "noopener", class: "btn btn-stream-search" do %>
          <span class="media-source-icon" aria-hidden="true"><%= ui_icon('book') %></span>
          <span class="media-source-label">Search Goodreads</span>
        <% end %>
        <%= link_to "https://openlibrary.org/search?q=#{CGI.escape(item.title)}", target: "_blank", rel: "noopener", class: "btn btn-stream-search" do %>
          <span class="media-source-icon" aria-hidden="true"><%= ui_icon('library') %></span>
          <span class="media-source-label">Search Open Library</span>
        <% end %>
      <% end %>

      <%= link_to "https://www.google.com/search?q=stream+or+buy+#{CGI.escape(item.title)}", target: "_blank", rel: "noopener", class: "btn btn-stream-search" do %>
          <span class="media-source-icon" aria-hidden="true"><%= ui_icon('archive') %></span>
        <span class="media-source-label">Google Search Options</span>
      <% end %>

      <%= link_to "https://www.amazon.com/s?k=#{CGI.escape(item.title)}", target: "_blank", rel: "noopener", class: "btn btn-stream-search" do %>
          <span class="media-source-icon" aria-hidden="true"><%= ui_icon('folder') %></span>
        <span class="media-source-label">Buy on Amazon</span>
      <% end %>
    </div>
  </div>
