<% personal_visible = activity_personal_details_visible?(activity, lib_item) %>
<% media_title = media_item.try(:title) || media_item.try(:name) || 'Media' %>
<div class="card-2026" data-media-kind="<%= media_item.class.name %>">
  <div class="card-2026-cover">
    <% if media_item.respond_to?(:stored_cover_url) && media_item.stored_cover_url.present? %>
      <%= media_cover_image media_item, alt: "#{media_title} cover", loading: "lazy", decoding: "async" %>
    <% else %>
      <span class="fallback-emoji">
        <%= case media_item.class.name
            when 'Movie' then ui_icon('film')
            when 'Album' then ui_icon('disc')
            when 'Comic' then ui_icon('library')
            when 'TvShow' then ui_icon('tv')
            when 'VideoGame' then ui_icon('gamepad')
            when 'Book' then ui_icon('book')
            when 'WrestlingEvent' then ui_icon('wrestling')
            else ui_icon('archive')
            end %>
      </span>
    <% end %>
  </div>
  <div class="card-2026-content">
    <h3 class="card-2026-title"><%= link_to media_item.title, media_item, data: { turbo_frame: "_top" } %></h3>
    
    <div class="card-2026-activity-meta">
      <div class="activity-user">
        <%= user_avatar_tag(activity.user, size: 20) %>
        <span class="friend-name"><%= link_to activity.user.name, activity.user %></span>
      </div>
      <div class="activity-stats">
        <% if personal_visible && lib_item.respond_to?(:rating) && lib_item.rating.present? %>
          <span class="friend-stars"><%= render_stars(lib_item.rating) %></span>
        <% end %>
        <% if personal_visible && lib_item.respond_to?(:rating) && lib_item.rating.to_f >= 4.0 %>
          <span class="heart-icon" style="color: var(--destructive); margin-left: 4px;"><%= ui_icon('heart') %></span>
        <% end %>
      </div>
      <div class="activity-date" style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px;">
        <%= activity.created_at.strftime("%b %d") %>
      </div>
    </div>
  </div>
</div>
