<% if logged_in? %>
  <nav class="library-switch" aria-label="<%= media_catalog(klass).first %> collection">
    <%= link_to 'Browse catalog', polymorphic_path(klass), aria: { current: @personal_library ? nil : 'page' } %>
    <%= link_to 'My library', polymorphic_path(klass, library: 'mine'), aria: { current: @personal_library ? 'page' : nil } %>
  </nav>
<% end %>
