<% content_for(:media_workspace, 'true') %>
<%
  title, _, icon = media_catalog(item)
  stats = community_stats_for(item)
  overview_facts = media_metadata(item).reject do |_, _, attribute|
    %w[Movie TvShow].include?(item.class.name) && %i[actors writer].include?(attribute)
  end
  entries = item.is_a?(TvShow) ? item.tv_episodes : (item.is_a?(Comic) ? item.comic_issues : nil)
  @child_library_items = @episode_library_items || @issue_library_items || (LibraryItem.where(user: current_user, item_type: entries.klass.name, item_id: entries.select(:id)).index_by(&:item_id) if entries && logged_in?)
  @series_library_item = @library_item
  @active_pass ||= ConsumptionPasses.current_pass(@series_library_item) if @series_library_item
  @active_pass_entry_ids ||= ConsumptionPasses.pass_entry_ids(@active_pass)
  entries_label = item.is_a?(TvShow) ? 'Episodes' : 'Issues'
%>
<% content_for(:title, item.title) %>
<% content_for(:meta_description, ([item.title] + media_metadata(item).map(&:last)).join(' • ')) %>
<% content_for(:item_detail, 'true') %>
<article class="media-detail" data-media-kind="<%= item.class.name %>">
  <%= link_to "← Back to #{title}", polymorphic_path(item.class), class: 'media-back-link' %>
  <header id="overview" class="media-overview">
    <div class="media-cover">
      <% original = item.is_a?(VideoGame) && @library_item&.game_cover_image&.attached? ? rails_storage_proxy_path(@library_item.game_cover_image) : ("#{item.stored_cover_url}?size=original" if item.stored_cover_url.present?) %>
      <% if original %>
        <%= artwork_lightbox(original, "#{item.title} cover") do %>
          <% if item.is_a?(VideoGame) %>
            <%= game_library_image(item, @library_item, alt: "#{item.title} cover", class: "game-cover-art", sizes: "(max-width: 600px) 120px, 180px") %>
          <% else %>
            <%= media_cover_image item, alt: "#{item.title} cover", sizes: "(max-width: 600px) 120px, 180px", loading: "eager" %>
          <% end %>
        <% end %>
      <% else %>
        <div class="artwork-fallback"><span aria-hidden="true"><%= ui_icon(icon) %></span><span>No cover yet</span></div>
      <% end %>
    </div>
    <div class="media-identity">
      <h1><%= item.title %></h1>
      <dl class="media-facts">
        <% overview_facts.each do |label, value, attribute| %>
          <div><dt><%= label %></dt><dd><%= render_media_metadata_value(item, attribute, value) %></dd></div>
        <% end %>
      </dl>
      <div id="media_personal_rating_<%= item.class.name.underscore %>_<%= item.id %>">
        <% if @library_item&.rating.present? %>
          <p class="media-personal-rating"><span>Your rating</span> <%= render_stars(@library_item.rating) %></p>
        <% end %>
      </div>
      <details class="media-share" id="share-title-<%= item.id %>"><summary>Share this title</summary><%= render 'shared/item_sharing', item: item %></details>
    </div>
    <aside class="media-overview-stats" aria-label="Community summary">
      <div><strong><%= stats[:avg_rating] ? "#{stats[:avg_rating]} ★" : '—' %></strong><span>Average rating</span></div>
      <div><strong><%= stats[:watchers].size %></strong><span><%= media_audience(item) %></span></div>
      <div><strong><%= stats[:collectors].size %></strong><span>Collectors</span></div>
    </aside>
  </header>
  <nav data-controller="media-sections" class="media-section-nav" aria-label="On this page">
    <a href="#overview">Overview</a>
    <a href="#my-library">My Library</a>
    <% if media_metadata(item).any? || (item.is_a?(VideoGame) && (item.synopsis.present? || item.metadata_details.present?)) %>
      <a href="#title-details">Details</a>
    <% end %>
    <% if entries %><a href="#media-entries"><%= entries_label %> <span><%= entries.size %></span></a><% end %>
    <% if item.is_a?(VideoGame) %>
      <% if @library_item %>
        <a href="#my-game-tracking">Gaming record</a>
        <a href="#game-copies">My copies</a>
        <a href="#game-playthroughs">Playthroughs</a>
        <a href="#game-journal">Journal</a>
      <% end %>
      <a href="#game-artwork">Artwork</a>
      <% if @library_item %>
        <a href="#game-tools">Export &amp; tools</a>
      <% end %>
    <% end %>
    <a href="#community">Community</a>
    <a href="#comments">Comments</a>
  </nav>
  <div class="media-detail-body">
    <div class="media-detail-main">
      <div id="my-library"><%= render 'shared/media_actions_and_stream', item: item, show_sources: false %></div>
      <%= render 'shared/media_description', item: item %>
      <%= render 'shared/entity_credits', item: item %>
      <%= render 'shared/provider_details', item: item %>
      <%= render 'albums/tracks', item: item if item.is_a?(Album) %>
      <% if item.is_a?(VideoGame) %>
        <% if @library_item %>
          <%= render 'tracking', library: @library_item %>
        <% else %>
          <div id="my-game-tracking" style="display: none;"></div>
        <% end %>
        <%= render 'artwork_gallery', game: @video_game, library: @library_item %>
      <% end %>
      <div id="media_my_review_<%= item.class.name.underscore %>_<%= item.id %>">
        <% if @library_item&.review.present? %>
          <section class="show-review media-section">
            <div class="show-review-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <h2 style="margin: 0;">My Review</h2>
              <%= link_to "Edit review", edit_review_path(item_type: item.class.name, item_id: item.id), class: "sleek-btn sleek-btn-secondary", style: "font-size: 0.8125rem; padding: 0.35rem 0.75rem;", data: { turbo_frame: "modal" } %>
            </div>
            <blockquote><%= simple_format(@library_item.review) %></blockquote>
          </section>
        <% end %>
      </div>
      <% if entries %>
        <section id="media-entries" data-controller="child-collection" data-action="season-tabs:change->child-collection#filter" class="media-section media-entries" aria-label="<%= entries_label %>">
          <h2><%= entries_label %> in this series</h2>
          <% if logged_in? %>
            <%
              # Use preloaded @child_library_items in-memory hash to avoid redundant SQL query
              completed = if @active_pass&.rewatch?
                            @active_pass_entry_ids.size
                          elsif @child_library_items
                            @child_library_items.values.count(&:consumed?)
                          else
                            0
                          end
            %>
            <p class="media-progress"><strong data-child-collection-target="completed"><%= number_with_delimiter(completed) %> of <%= number_with_delimiter(entries.size) %></strong> <%= entries_label.downcase %> <%= MediaLanguage.for(item)[:past] %></p>
            <progress data-child-collection-target="progress" value="<%= completed %>" max="<%= [entries.size, 1].max %>" aria-label="<%= entries_label %> completed"></progress>
            <%= render 'shared/consumption_pass_panel', item: item, library_item: @library_item if @library_item.present? %>
          <% end %>
          <div class="child-collection-toolbar">
            <div><label for="child-search">Search <%= entries_label.downcase %></label><input id="child-search" type="search" placeholder="Search by title or number" data-child-collection-target="search" data-action="input->child-collection#filter"></div>
            <% if @library_item.present? %>
              <div><label for="child-status"><%= item.is_a?(TvShow) ? "Watch" : "Read" %> status</label><select id="child-status" data-child-collection-target="status" data-action="change->child-collection#filter"><option value="all">All <%= entries_label.downcase %></option><option value="false"><%= item.is_a?(TvShow) ? 'Unwatched' : 'Unread' %></option><option value="true"><%= item.is_a?(TvShow) ? 'Watched' : 'Read' %></option></select></div>
            <% end %>
            <p role="status" aria-live="polite" data-child-collection-target="result"></p>
          </div>
          <%= render(item.is_a?(TvShow) ? 'tv_shows/catalog_episodes' : 'comics/catalog_issues') %>
          <p hidden class="child-collection-empty" data-child-collection-target="empty">No matching <%= entries_label.downcase %>. Try another title, number, or progress filter.</p>
        </section>
      <% end %>
      <%= render 'shared/media_community', item: item, stats: stats %>
    </div>
    <aside class="media-detail-aside" aria-label="Sources and title tools">
      <%= render 'shared/media_sources', item: item %>
      <%= render 'shared/metadata_refresh', item: item %>
      <% if logged_in? %>
        <%= link_to 'Suggest an edit', new_polymorphic_path([item, :edit_suggestion]), class: 'media-tool-link' %>
      <% end %>
    </aside>
  </div>
</article>
