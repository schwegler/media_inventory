<% content_for :title, 'Shelves' %>
<% content_for :robots, 'noindex, nofollow' %>
<section class="shelves-workspace">
  <header class="workspace-heading"><div><h1>Shelves</h1><p>Make room for what you love.</p></div><div class="workspace-actions"><%= link_to 'Create shelf', new_managed_shelf_path, class: 'workspace-primary' %><%= link_to 'View public shelves', shelf_path(@user.username), class: 'workspace-secondary' %></div></header>
  <section class="workspace-panel" aria-labelledby="custom-shelves-heading"><h2 id="custom-shelves-heading">Custom shelves</h2><p>Your personal shelves for any theme, mood, or part of your life.</p>
    <% if @collections.empty? %><div class="workspace-empty"><h3>Your next shelf starts here.</h3><p>Bring together up to 1,000 films, books, albums, shows, comics and games.</p><%= link_to 'Create your first shelf', new_managed_shelf_path, class: 'workspace-primary' %></div><% end %>
    <% @collections.each do |collection| %>
      <article class="workspace-row"><div class="workspace-covers" aria-hidden="true"><% collection.preview_items.first(2).each do |item| %><% if item.stored_cover_url.present? %><%= image_tag item.stored_cover_url, alt: '', loading: 'lazy' %><% end %><% end %></div><div class="workspace-row-copy"><h3><%= collection.title %></h3><p><%= pluralize(collection.picks.size, 'title') %><% if collection.description.present? %> · <%= collection.description %><% end %></p></div><div class="workspace-row-actions"><%= link_to 'Edit shelf', edit_managed_shelf_path(collection.slug), aria: { label: "Edit #{collection.title}" } %><%= link_to 'View public shelf', shelf_path(@user.username, collection: collection.slug), aria: { label: "View #{collection.title} publicly" } %><%= link_to 'Settings', managed_shelf_settings_path(collection.slug), aria: { label: "Settings for #{collection.title}" } %></div></article>
    <% end %>
  </section>
  <section class="workspace-panel" aria-labelledby="favorites-heading"><h2 id="favorites-heading">Favorites</h2><p>Your seven default shelves, always here. Up to five picks on each.</p>
    <% @favorites.each do |shelf| %><article class="workspace-row"><div class="workspace-row-copy"><h3><%= shelf[:label] %></h3><p><%= pluralize(shelf[:items].size, 'pick') %> of 5</p></div><div class="workspace-row-actions"><%= link_to 'Edit picks', edit_favorite_shelf_path(shelf[:key]), aria: { label: "Edit #{shelf[:label]} favorites" } %><%= link_to 'View public shelf', shelf_path(@user.username, category: shelf[:key]), aria: { label: "View #{shelf[:label]} publicly" } %></div></article><% end %>
    <%= link_to 'Edit public headline & appearance', shelf_appearance_path, class: 'workspace-text-link' %>
  </section>
  <% if @archived.any? %><section class="workspace-panel" aria-labelledby="archived-heading"><h2 id="archived-heading">Archived shelves</h2><p>Selections are retained. Restore a shelf to make its original public link available again. A current published preview can make it eligible for discovery again.</p><% @archived.each do |collection| %><article class="workspace-row"><div class="workspace-row-copy"><h3><%= collection.title %></h3><p><%= pluralize(collection.picks.size, 'title') %> retained</p></div><%= button_to 'Restore shelf', restore_managed_shelf_path(collection.slug), method: :patch, class: 'workspace-secondary', form: { data: { turbo_submits_with: 'Restoring…' } } %></article><% end %></section><% end %>
</section>
