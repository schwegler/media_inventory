<% content_for :title, 'Archive shelf' %><% content_for :robots, 'noindex, nofollow' %>
<section class="shelves-workspace workspace-form-page"><%= link_to 'Back to shelf settings', managed_shelf_settings_path(@collection.slug), class: 'workspace-back' %><h1>Archive shelf</h1><p><strong><%= @collection.title %></strong> will disappear from your public overview and title-page discovery. Its public link will return not found until restored. All <%= pluralize(@collection.picks.size, 'title') %>, their order and settings are retained.</p><p>Restore it at any time from Shelves. A current published preview can make the restored shelf eligible for discovery again.</p>
<% if @collection.errors.any? %><div class="workspace-errors" role="alert"><%= @collection.errors.full_messages.to_sentence %></div><% end %>
<%= form_with url: archive_managed_shelf_path(@collection.slug), method: :patch do |form| %><%= hidden_field_tag :shelf_version, shelf_edit_version(@user, "collection:#{@collection.slug}") %><div class="workspace-field"><%= form.label :confirmation, 'Type the shelf title to confirm' %><%= form.text_field :confirmation, required: true, autocomplete: 'off' %></div><div class="workspace-form-actions"><%= form.submit 'Archive shelf', class: 'workspace-primary', data: { turbo_submits_with: 'Archiving…' } %><%= link_to 'Cancel', managed_shelf_settings_path(@collection.slug), class: 'workspace-secondary' %></div><% end %></section>
