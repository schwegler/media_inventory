<div class="page-header">
  <h1>Albums</h1>
  <% if logged_in? %>
    <%= link_to 'New Album', new_album_path, class: 'sleek-btn sleek-btn-primary' %>
  <% end %>
</div>

<turbo-frame id="items_list">
  <% if @albums.empty? %>
    <%= render 'shared/catalog_empty_state', media_name: 'albums', singular_name: 'album', article: 'an', new_item_path: new_album_path %>
  <% end %>
  <div class="media-grid-2026">
    <% @albums.each do |album| %>
      <%= render partial: 'shared/media_card', locals: { media_item: album } %>
    <% end %>
  </div>

  <div class="pagination-wrapper">
    <%= paginate @albums %>
  </div>
</turbo-frame>
