<div class="home-discovery-search">
  <%= form_with url: search_path, method: :get, class: 'discovery-query' do |f| %>
    <%= f.label :q, 'Find something you love', for: 'home-discovery-query', class: 'visually-hidden' %>
    <%= f.search_field :q, id: 'home-discovery-query', placeholder: 'An album, artist, book, film or game…', maxlength: 200, required: true %>
    <%= f.submit 'Search', class: 'sleek-btn sleek-btn-primary' %>
  <% end %>
  <div class="home-search-meta">
    <span>Search first. Sign in to collect.</span>
    <details class="home-catalog-note">
      <summary>About the catalog</summary>
      <p>Search titles <strong>In Trove</strong> or find metadata <strong>Available to import</strong> from supported catalogs. Coverage varies by provider and region. Music discovery searches albums.</p>
    </details>
  </div>
</div>
