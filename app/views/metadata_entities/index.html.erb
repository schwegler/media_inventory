<% content_for(:media_workspace, 'true') %>
<% content_for(:title, 'Discover people and metadata — Trove') %>
<section class="catalog-page entity-page" aria-labelledby="entity-heading">
  <header class="catalog-heading"><div><p class="entity-eyebrow">CONNECTED DISCOVERY</p><h1 id="entity-heading">People &amp; Metadata</h1><p>Follow the people, organizations and ideas behind your collection.</p></div></header>
  <%= form_with url: metadata_entities_path, method: :get, class: 'catalog-toolbar' do |f| %>
    <div><%= f.label :q, 'Find an entity' %><%= f.search_field :q, value: @query, placeholder: 'Artist, creator, publisher…' %></div>
    <div><%= f.label :kind, 'Category' %><%= f.select :kind, [['All categories', '']] + MetadataEntity::KINDS.map { |kind| [kind == 'person' ? 'People' : kind.titleize, kind] }, selected: @kind %></div>
    <div><%= f.label :role, 'Credit role' %><%= f.text_field :role, value: params[:role], placeholder: 'Writer, Album artist…' %></div>
    <% if logged_in? %><div><%= f.label :library, 'Library' %><%= f.select :library, [['All Trove', 'all'], ['My library', 'mine']], selected: @library %></div><% end %>
    <div><%= f.label :sort, 'Sort' %><%= f.select :sort, [['Name A–Z', 'name'], ['Most credits', 'count']], selected: params[:sort] %></div>
    <%= f.submit 'Explore', class: 'sleek-btn sleek-btn-secondary' %>
  <% end %>
  <% if @entities.empty? %><div class="home-empty-state"><h2>No matching entities</h2><p>Try a different name or category. Entities appear as credits are added to the catalog.</p></div><% end %>
  <div class="entity-grid">
    <% @entities.each do |entity| %>
      <%= link_to metadata_entity_path(entity, library: @library), class: 'entity-tile' do %>
        <% if entity.stored_cover_url %><%= image_tag entity.stored_cover_url, alt: "", class: "entity-monogram", loading: "lazy" %><% else %><span class="entity-monogram" aria-hidden="true"><%= entity.name.first %></span><% end %>
        <span><strong><%= entity.display_name %></strong><small><%= entity.kind.titleize %> · <%= pluralize(@counts[entity.id].to_i, 'credit') %></small></span>
      <% end %>
    <% end %>
  </div>
  <div class="pagination-wrapper"><%= paginate @entities %></div>
</section>
