<% content_for :turbo_no_cache, 'true' %>
<section id="book-editions" class="media-section">
  <h2>Editions &amp; chapters</h2>
  <p>Chapter lists and reading/listening passes belong to an edition. Finishing chapters does not mark this book finished or change its rating.</p>
  <% editions = book.book_editions.order(:id).includes(:book_chapters).to_a %>
  <% library = logged_in? ? current_user.library_items.find_by(item: book) : nil %>
  <% passes = library ? library.book_reading_passes.includes(:book_chapter_completions).order(:number).to_a.group_by(&:book_edition_id) : {} %>
  <% if editions.empty? %><p>No edition chapter list yet. Chapters are unknown.</p><% end %>
  <% editions.each do |edition| %>
    <section id="edition-<%= edition.id %>" class="book-edition">
      <h3><%= edition.display_title %></h3>
      <p><%= edition.structure_kind.humanize %> · Edition source: <%= edition.source %><%= " (#{edition.source_id})" if edition.source_id.present? %><%= " · #{edition.published_on}" if edition.published_on %><%= " · ISBN #{edition.isbn}" if edition.isbn.present? %></p>
      <% chapters = edition.book_chapters.sort_by { |chapter| [chapter.position, chapter.id] } %>
      <% history = passes[edition.id] || []; pass = history.last %>
      <% done = pass ? pass.book_chapter_completions.map(&:book_chapter_id) : [] %>
      <% if chapters.empty? %>
        <p>No chapter list available. Progress is unknown.</p>
        <% if library %>
          <details><summary>Add a manual list for this edition</summary>
            <%= form_with url: book_book_edition_path(book, edition), method: :patch, data: { turbo: false }, class: 'standard-form' do %>
              <%= label_tag "chapters_#{edition.id}", 'Chapter list (one per line)' %>
              <%= text_area_tag :chapters, nil, id: "chapters_#{edition.id}", rows: 7, required: true %>
              <p>Optional syntax: Part | Label | Title. Use only the list for this edition.</p>
              <%= check_box_tag :complete_chapter_list, '1', false, id: "complete_list_#{edition.id}" %>
              <%= label_tag "complete_list_#{edition.id}", 'This is the complete list for this edition' %>
              <%= submit_tag 'Save chapter list', class: 'sleek-btn sleek-btn-primary' %>
            <% end %>
          </details>
        <% end %>
      <% else %>
        <p>List provenance: <%= chapters.map(&:provenance).uniq.join(', ') %> · <%= edition.complete_chapter_list? ? 'Complete chapter list' : 'Partial chapter list; total unknown' %></p>
        <% if library %>
          <p><%= done.size %> of <%= chapters.size %> known <%= edition.structure_kind.humanize.downcase %> completed<%= " · Pass #{pass.number}" if pass %>.</p>
          <% if history.size > 1 %><details><summary>Earlier passes</summary><ul><% history[0...-1].each do |prior| %><li>Pass <%= prior.number %>: <%= prior.book_chapter_completions.size %> completed</li><% end %></ul></details><% end %>
          <%= button_to pass ? 'Start another reading/listening pass' : 'Start reading/listening', book_reading_passes_path, params: { book_edition_id: edition.id, previous_number: pass&.number || 0 }, form: { data: { turbo: false } }, class: 'sleek-btn sleek-btn-secondary' %>
        <% end %>
        <ol class="book-chapter-list">
          <% chapters.each do |chapter| %>
            <li><div><% if chapter.part.present? %><small><%= chapter.part %></small><% end %> <%= link_to chapter.display_title, book_chapter_path(chapter) %></div>
              <% if pass %><%= button_to done.include?(chapter.id) ? 'Undo completion' : 'Mark completed', book_reading_pass_path(pass), method: :patch, params: { chapter_id: chapter.id, completed: !done.include?(chapter.id) }, form: { data: { turbo: false } }, class: 'sleek-btn sleek-btn-secondary', aria: { label: "#{done.include?(chapter.id) ? 'Undo' : 'Complete'} #{chapter.display_title}" } %><% end %>
            </li>
          <% end %>
        </ol>
      <% end %>
    </section>
  <% end %>
  <% if library %>
    <details><summary>Add an edition and manual chapter list</summary>
      <p>Use a list from your edition. Audiobook segments may differ from literary chapters. Existing lists and reviews are preserved.</p>
      <%= form_with scope: :book_edition, url: book_book_editions_path(book), data: { turbo: false }, class: 'standard-form' do |f| %>
        <div class="form-group"><%= f.label :label, 'Edition label' %><%= f.text_field :label, required: true, maxlength: 255, placeholder: 'Publisher, year, narrator, or edition name' %></div>
        <div class="form-group"><%= f.label :format %><%= f.select :format, %w[print ebook audiobook unknown] %></div>
        <div class="form-group"><%= f.label :structure_kind, 'List describes' %><%= f.select :structure_kind, [['Literary chapters', 'chapters'], ['Audiobook segments', 'audio_segments']] %></div>
        <div class="form-group"><%= f.label :isbn, 'ISBN (optional)' %><%= f.text_field :isbn %></div>
        <div class="form-group"><%= f.label :published_on, 'Edition publication date (optional)' %><%= f.date_field :published_on %></div>
        <div class="form-group"><%= label_tag :chapters, 'Chapter list (one per line)' %><%= text_area_tag :chapters, nil, rows: 7, placeholder: "Prologue\nPart One | Chapter 1 | Arrival\nPart One | Chapter 2 | Departure" %><p>Optional grouping syntax: Part | Label | Title. Leave blank if chapters are unknown.</p></div>
        <div class="check-field"><%= f.check_box :complete_chapter_list %><%= f.label :complete_chapter_list, 'This is the complete list for this edition' %></div>
        <%= f.submit 'Add edition', class: 'sleek-btn sleek-btn-primary' %>
      <% end %>
    </details>
  <% elsif logged_in? %><p>Add this book to your library to create an edition list or track progress.</p><% end %>
</section>
