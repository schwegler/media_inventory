<div class="page-header">
  <h1>Comics</h1>
  <% if logged_in? %>
    <%= link_to 'New Comic', new_comic_path, class: 'sleek-btn sleek-btn-primary' %>
  <% end %>
</div>

<turbo-frame id="items_list">
  <% if @comics.empty? %>
    <%= render 'shared/catalog_empty_state', media_name: 'comics', singular_name: 'comic', article: 'a', new_item_path: new_comic_path %>
  <% end %>
  <div class="media-grid-2026">
    <% @comics.each do |comic| %>
      <%= render partial: 'shared/media_card', locals: { media_item: comic } %>
    <% end %>
  </div>

  <div class="pagination-wrapper">
    <%= paginate @comics %>
  </div>
</turbo-frame>
