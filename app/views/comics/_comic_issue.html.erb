<%
  issue_lib = (@child_library_items ? @child_library_items[issue.id] : LibraryItem.find_by(user: current_user, item: issue)) if logged_in?
  series_lib = @child_library_items ? @series_library_item : @series_library_item || (@library_item if @library_item&.item_type == 'Comic') || (logged_in? && LibraryItem.find_by(user: current_user, item: issue.comic))
  active_pass = @child_library_items ? @active_pass : @active_pass || (series_lib && ConsumptionPasses.current_pass(series_lib))
  pass_entry_ids = @active_pass_entry_ids || ConsumptionPasses.pass_entry_ids(active_pass)

  is_read = ConsumptionPasses.consumed?(
    issue,
    user: current_user,
    series_lib: series_lib,
    child_lib: issue_lib,
    pass: active_pass,
    entry_ids: pass_entry_ids
  )
%>
<%# Local variables: issue, comic %>
<%= turbo_frame_tag "comic_issue_#{issue.id}", data: { child_collection_target: "entry", search: issue.display_title, completed: is_read ? "true" : "false" } do %>
  <details class="episode-item child-entry">
    <summary class="child-entry-summary">
    <div class="episode-content-row">
      <% if issue.stored_cover_url.present? %>
        <img src="<%= issue.stored_cover_url %>" alt="<%= issue.title %>" class="episode-thumbnail" loading="lazy" decoding="async">
      <% end %>
      <div class="episode-info">
        <div class="episode-header">
          <span>
            <%= link_to "##{issue.issue_number}: #{issue.title.presence || 'Untitled issue'}", comic_issue_path(issue), class: "episode-link", data: { turbo_frame: "_top" } %>
            <% if issue.release_date.present? %>
              <span class="episode-air-date">Released <%= issue.release_date %></span>
            <% end %>
          </span>


          <% if logged_in? && series_lib.present? %>
            <div class="episode-actions-wrapper">
              <% if is_read %>
                <span class="episode-badge-watched">✓ Read</span>
              <% else %>
                <span class="episode-badge-not-watched">Unread</span>
              <% end %>
            </div>
          <% end %>
        </div>

      </div>
    </div>
    </summary>
    <div class="child-entry-body">
        <%= render 'shared/child_description', item: issue %>
        <%= render 'shared/child_metadata', item: issue %>

        <% has_reviewed = is_read && (issue_lib&.review.present? || issue_lib&.rating.present?) %>
        <% if has_reviewed %>
          <div class="episode-rating-review-box">
            <div class="episode-rating-review-content">
              <% if issue_lib.rating.present? %>
                <span class="episode-stars"><%= issue_lib.rating %> ★</span>
              <% end %>
              <% if issue_lib.review.present? %>
                <span class="episode-review-text"><%= issue_lib.review %></span>
              <% end %>
            </div>
            <%= link_to "Edit review", edit_review_path(item_type: 'ComicIssue', item_id: issue.id),
                        class: "episode-btn-edit-review", data: { turbo_frame: "modal" } %>
          </div>
        <% end %>

    <% if logged_in? && series_lib.present? %>
      <div class="episode-form-section" aria-label="Read, rate, or review">
        <% if is_read %>
          <div class="episode-reviewed-actions">
            <%= button_to "Undo", toggle_read_comic_issue_path(issue), method: :patch,
                          params: { comic_issue: { consumed: false, consumed_at: nil } },
                          class: "episode-btn-unwatch", aria: { label: "Mark as unread" } %>
            <% if has_reviewed %>
              <%= link_to "Edit review", edit_review_path(item_type: 'ComicIssue', item_id: issue.id),
                          class: "episode-btn-edit-review", data: { turbo_frame: "modal" } %>
            <% end %>
          </div>
        <% end %>
        <% unless has_reviewed %>
          <%= form_with model: issue, url: toggle_read_comic_issue_path(issue), method: :patch do |form| %>
            <%= form.hidden_field :consumed, value: true %>
            <%= form.hidden_field :consumed_at, value: Time.current.to_date %>

            <div class="inline-checkbox-group">
              <%= form.check_box :is_public, checked: issue_lib&.is_public?, id: "public-issue-#{issue.id}" %>
              <%= form.label :is_public, "Make review public", for: "public-issue-#{issue.id}" %>
            </div>

            <div class="episode-form-inputs">
              <label class="child-review-label" for="child-review-<%= issue.id %>">Your review <span>(optional)</span></label>
              <%= form.text_area :review, value: issue_lib&.review, aria: { label: "Issue review" }, placeholder: is_read ? "Edit review..." : "Review this issue...", id: "child-review-#{issue.id}", rows: 3, class: "episode-input-review" %>

              <%= form.select :rating, [["Rating", ""], ["½ ★", "0.5"], ["★", "1.0"], ["★½", "1.5"], ["★★", "2.0"], ["★★½", "2.5"], ["★★★", "3.0"], ["★★★½", "3.5"], ["★★★★", "4.0"], ["★★★★½", "4.5"], ["★★★★★", "5.0"]], { selected: issue_lib&.rating }, { class: "episode-select-rating", aria: { label: "Rating" } } %>
              <% if is_read %>
                <%= form.submit "Update", class: "episode-btn-rate" %>
              <% else %>
                <%= form.submit "Read", class: "episode-btn-rate" %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
    </div>
  </details>
<% end %>
