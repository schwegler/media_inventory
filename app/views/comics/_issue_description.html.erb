<% if strip_tags(issue.summary.to_s).squish.present? %>
  <section class="issue-description" aria-label="Issue description">
    <h3>Description</h3>
    <% if strip_tags(issue.summary).length > 420 %>
      <details class="issue-description-disclosure">
        <summary><span class="issue-description-more">Read full description</span><span class="issue-description-less">Show less</span></summary>
        <div class="issue-description-prose"><%= comic_issue_description(issue.summary) %></div>
      </details>
      <p class="issue-description-preview"><%= truncate(strip_tags(issue.summary.gsub(/<\/(?:p|li|blockquote|h[2-4])>|<br\s*\/?\s*>/i, ' ')).squish, length: 420, separator: ' ') %></p>
    <% else %>
      <div class="issue-description-prose"><%= comic_issue_description(issue.summary) %></div>
    <% end %>
  </section>
<% end %>
