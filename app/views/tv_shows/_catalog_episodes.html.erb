    <% if @tv_show.tv_episodes.any? %>
      <%
        episodes_by_season = @tv_show.tv_episodes.with_attached_cover_image.includes(:tv_show, metadata_credits: :metadata_entity).order(:season, :episode).group_by(&:season)
        sorted_seasons = episodes_by_season.keys.sort
      %>
      <div class="show-episodes-section"  data-controller="season-tabs" data-season-tabs-show-id-value="<%= @tv_show.id %>" data-action="turbo:morph@document->season-tabs#restore">

        <div class="season-selector">
          <label class="visually-hidden" for="series-season">Season</label>
          <select id="series-season" data-season-tabs-target="selector" data-action="change->season-tabs#choose">
            <% sorted_seasons.each do |season| %><option value="<%= season %>">Season <%= season %></option><% end %>
          </select>
          <button type="button" class="sleek-btn sleek-btn-secondary" aria-label="Previous season" data-season-tabs-target="previous" data-action="season-tabs#previous">‹</button>
          <button type="button" class="sleek-btn sleek-btn-secondary" aria-label="Next season" data-season-tabs-target="next" data-action="season-tabs#next">›</button>
        </div>

        <div>
          <% sorted_seasons.each_with_index do |season, index| %>
            <div id="season-panel-<%= season %>"
                 role="region"
                 aria-label="Season <%= season %>"
                 tabindex="0"
                 data-season-tabs-target="content"
                 data-season="<%= season %>"
                 class="season-episodes-list <%= 'hidden' unless index == 0 %>"
                 >
              <% season_eps = episodes_by_season[season] %>
              <% if logged_in? %>
                <%
                  watched_count = season_eps.count do |ep|
                    ConsumptionPasses.consumed?(
                      ep,
                      user: current_user,
                      series_lib: @series_library_item || @library_item,
                      child_lib: (@child_library_items ? @child_library_items[ep.id] : nil),
                      pass: @active_pass,
                      entry_ids: @active_pass_entry_ids
                    )
                  end
                  all_watched = watched_count == season_eps.size
                %>
                <div class="season-panel-header" id="season-panel-header-<%= season %>">
                  <div class="season-panel-status">
                    <span class="season-count-badge">Season <%= season %></span>
                    <span class="season-watched-tally">
                      <strong><%= watched_count %></strong> of <strong><%= season_eps.size %></strong> watched
                    </span>
                  </div>
                  <div class="season-panel-actions">
                    <% if all_watched %>
                      <%= button_to "Undo season",
                                    mark_season_watched_tv_show_path(@tv_show, season: season),
                                    method: :patch,
                                    params: { consumed: false },
                                    class: "sleek-btn sleek-btn-secondary episode-btn-unwatch",
                                    aria: { label: "Mark Season #{season} as unwatched" } %>
                    <% else %>
                      <%= button_to "Mark season watched",
                                    mark_season_watched_tv_show_path(@tv_show, season: season),
                                    method: :patch,
                                    params: { consumed: true },
                                    data: { turbo_confirm: "Mark all episodes in Season #{season} watched?" },
                                    class: "sleek-btn sleek-btn-secondary season-btn-watch",
                                    aria: { label: "Mark Season #{season} as watched" } %>
                    <% end %>
                  </div>
                </div>
              <% end %>
              <% season_eps.each do |ep| %>
                <%= render 'tv_shows/tv_episode', ep: ep, tv_show: @tv_show %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @tv_show.tv_episodes.empty? %>
      <div class="home-empty-state"><h2>No episodes yet</h2><p>The source may not have supplied them yet. Use Artwork &amp; metadata above to check for new releases.</p></div>
    <% end %>
