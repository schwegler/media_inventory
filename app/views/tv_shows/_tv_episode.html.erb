<%
  ep_lib = (@child_library_items ? @child_library_items[ep.id] : LibraryItem.find_by(user: current_user, item: ep)) if logged_in?
  series_lib = @series_library_item || (@library_item if @library_item&.item_type == 'TvShow') || (logged_in? && LibraryItem.find_by(user: current_user, item: ep.tv_show))
  active_pass = @active_pass || (series_lib && ConsumptionPasses.current_pass(series_lib))
  pass_entry_ids = @active_pass_entry_ids || ConsumptionPasses.pass_entry_ids(active_pass)

  is_watched = ConsumptionPasses.consumed?(
    ep,
    user: current_user,
    series_lib: series_lib,
    child_lib: ep_lib,
    pass: active_pass,
    entry_ids: pass_entry_ids
  )
%>
<%# Local variables: ep, tv_show %>
<%= turbo_frame_tag "tv_episode_#{ep.id}", data: { child_collection_target: "entry", search: "#{ep.episode} #{ep.name}", completed: is_watched ? "true" : "false" } do %>
  <details class="episode-item child-entry">
    <summary class="child-entry-summary">
    <div class="episode-content-row">
      <% if ep.stored_cover_url.present? %>
        <img src="<%= ep.stored_cover_url %>" alt="<%= ep.name %>" class="episode-thumbnail" loading="lazy" decoding="async">
      <% end %>
      <div class="episode-info">
        <div class="episode-header">
          <span>
            <%= link_to "#{ep.episode}. #{ep.name}", tv_episode_path(ep), class: "episode-link", data: { turbo_frame: "_top" } %>
            <% if ep.air_date.present? %>
              <span class="episode-air-date">Aired <%= ep.air_date %></span>
            <% end %>
          </span>


          <% if logged_in? && series_lib.present? %>
            <div class="episode-actions-wrapper">
              <% if is_watched %>
                <span class="episode-badge-watched">✓ Watched</span>
              <% else %>
                <span class="episode-badge-not-watched">Unwatched</span>
              <% end %>
            </div>
          <% end %>
        </div>

      </div>
    </div>
    </summary>
    <div class="child-entry-body">
        <%= render 'shared/child_metadata', item: ep %>
        <% if ep.summary.present? %>
          <div class="episode-summary">
            <%= strip_tags(ep.summary) %>
          </div>
        <% end %>

        <% has_reviewed = is_watched && (ep_lib&.review.present? || ep_lib&.rating.present?) %>
        <% if has_reviewed %>
          <div class="episode-rating-review-box">
            <div class="episode-rating-review-content">
              <% if ep_lib.rating.present? %>
                <span class="episode-stars"><%= ep_lib.rating %> ★</span>
              <% end %>
              <% if ep_lib.review.present? %>
                <span class="episode-review-text"><%= ep_lib.review %></span>
              <% end %>
            </div>
            <%= link_to "Edit review", edit_review_path(item_type: 'TvEpisode', item_id: ep.id),
                        class: "episode-btn-edit-review", data: { turbo_frame: "modal" } %>
          </div>
        <% end %>

    <% if logged_in? && series_lib.present? %>
      <div class="episode-form-section" aria-label="Watch, rate, or review">
        <% if is_watched %>
          <div class="episode-reviewed-actions">
            <%= button_to "Undo", toggle_watched_tv_episode_path(ep), method: :patch,
                          params: { tv_episode: { consumed: false, consumed_at: nil } },
                          class: "episode-btn-unwatch", aria: { label: "Mark as unwatched" } %>
            <% if has_reviewed %>
              <%= link_to "Edit review", edit_review_path(item_type: 'TvEpisode', item_id: ep.id),
                          class: "episode-btn-edit-review", data: { turbo_frame: "modal" } %>
            <% end %>
          </div>
        <% end %>
        <% unless has_reviewed %>
          <%= form_with model: ep, url: toggle_watched_tv_episode_path(ep), method: :patch do |form| %>
            <%= form.hidden_field :consumed, value: true %>
            <%= form.hidden_field :consumed_at, value: Time.current.to_date %>

            <div class="inline-checkbox-group">
              <%= form.check_box :is_public, checked: ep_lib&.is_public?, id: "public-episode-#{ep.id}" %>
              <%= form.label :is_public, "Make review public", for: "public-episode-#{ep.id}" %>
            </div>

            <div class="episode-form-inputs">
              <label class="child-review-label" for="child-review-<%= ep.id %>">Your review <span>(optional)</span></label>
              <%= form.text_area :review, value: ep_lib&.review, aria: { label: "Episode review" }, placeholder: is_watched ? "Edit review..." : "Review this episode...", id: "child-review-#{ep.id}", rows: 3, class: "episode-input-review" %>

              <%= form.select :rating, [["Rating", ""], ["½ ★", "0.5"], ["★", "1.0"], ["★½", "1.5"], ["★★", "2.0"], ["★★½", "2.5"], ["★★★", "3.0"], ["★★★½", "3.5"], ["★★★★", "4.0"], ["★★★★½", "4.5"], ["★★★★★", "5.0"]], { selected: ep_lib&.rating }, { class: "episode-select-rating", aria: { label: "Rating" } } %>
              <% if is_watched %>
                <%= form.submit "Update", class: "episode-btn-rate" %>
              <% else %>
                <%= form.submit "Watch", class: "episode-btn-rate" %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
    </div>
  </details>
<% end %>
