<%
  ep_lib = (@child_library_items ? @child_library_items[ep.id] : LibraryItem.find_by(user: current_user, item: ep)) if logged_in?
  series_lib = @child_library_items ? @series_library_item : @series_library_item || (@library_item if @library_item&.item_type == 'TvShow') || (logged_in? && LibraryItem.find_by(user: current_user, item: ep.tv_show))
  active_pass = @child_library_items ? @active_pass : @active_pass || (series_lib && ConsumptionPasses.current_pass(series_lib))
  pass_entry_ids = @active_pass_entry_ids || ConsumptionPasses.pass_entry_ids(active_pass)

  is_watched = ConsumptionPasses.consumed?(
    ep,
    user: current_user,
    series_lib: series_lib,
    child_lib: ep_lib,
    pass: active_pass,
    entry_ids: pass_entry_ids
  )
%>
<%= render 'shared/series_entry', item: ep, child_lib: ep_lib, series_lib: series_lib,
           completed: is_watched, toggle_path: toggle_watched_tv_episode_path(ep) %>
