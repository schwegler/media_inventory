<section id="in_progress_section" class="profile-section profile-progress-dashboard" aria-labelledby="progress-heading" data-controller="profile-progress" data-action="turbo:submit-start->profile-progress#start turbo:submit-end->profile-progress#finish turbo:fetch-request-error->profile-progress#error">
  <p role="status" class="profile-progress-status profile-section-note" data-profile-progress-target="status"><%= local_assigns[:tracking_notice] %></p>
  <p role="alert" class="profile-tracking-error" hidden data-profile-progress-target="error"></p>
  <div class="profile-section-heading"><h2 id="progress-heading">In progress</h2><%= link_to 'Back to overview', profile_tab_path('overview') %></div>
  <% if local_assigns[:tracking_error].present? %><p role="alert" class="profile-tracking-error"><%= tracking_error %></p><% end %>
  <p class="profile-section-note"><%= @profile_owner ? 'Pick up where you left off. Recent activity uses your latest watch, read or play session.' : 'Explore the latest public watch and read activity in this library.' %> Editing a title does not move it up.</p>
  <p class="profile-section-note">TV watch progress is public. Private reviews and ratings stay hidden; only the owner can change progress.</p>
  <% if @profile_owner %><p class="profile-section-note">Games use your active playthroughs and stay private. For books, use <%= link_to 'your book library', books_path(library: 'mine') %> to log a finished read.</p><% end %>
  <%= form_with url: user_path(@user), method: :get, class: 'profile-filter profile-progress-filter' do |f| %>
    <%= hidden_field_tag :tab, 'progress' %>
    <%= hidden_field_tag :preview, 'public' if params[:preview] == 'public' %>
    <div><%= label_tag :type, 'Media type' %><%= select_tag :type, options_for_select([['All tracking', ''], ['TV shows', 'TvShow'], ['Comics', 'Comic']] + (@profile_owner ? [['Games', 'VideoGame']] : []), @progress_type) %></div>
    <div><%= label_tag :sort, 'Sort by' %><%= select_tag :sort, options_for_select([['Recent activity', 'recent'], ['Title A–Z', 'title'], ['Most progress', 'progress']], @progress_sort) %></div>
    <%= f.button 'Apply filters', class: 'sleek-btn sleek-btn-secondary', data: { turbo_submits_with: 'Loading…' } %>
  <% end %>
  <div class="profile-section-heading profile-progress-results"><p><%= pluralize(@in_progress_items.total_count, 'active title') %></p><% if @progress_type.present? || @progress_sort != 'recent' %><%= link_to 'Reset filters', profile_tab_path('progress') %><% end %></div>
  <% if @in_progress_items.any? %>
    <div class="in-progress-grid"><% @in_progress_items.each do |item| %><%= render(item.game? ? 'users/profile_game_progress' : 'shared/in_progress_card', in_progress: item, profile_owner: @profile_owner) %><% end %></div>
    <div class="pagination-wrapper"><%= paginate @in_progress_items %></div>
  <% else %>
    <div class="profile-empty"><h3><%= @progress_type.present? ? 'No matching titles.' : 'Nothing in progress yet.' %></h3>
      <p><%= @progress_type.present? ? 'Try All tracking to see your other titles.' : (@profile_owner ? 'Log an episode or issue, start a watch-through or read-through, or begin a game playthrough to see it here.' : 'No public tracking activity to show.') %></p>
      <%= link_to(@progress_type.present? ? 'Show all tracking' : 'Explore Trove', @progress_type.present? ? profile_tab_path('progress') : movies_path) %>
    </div>
  <% end %>
</section>
