<% if items.any? %>
  <div class="profile-media-grid<%= ' profile-media-row' if local_assigns[:compact] %>"<% if local_assigns[:compact] %> role="region" aria-label="Recently collected titles" tabindex="0"<% end %>>
    <% items.each do |entry| %>
      <% item = entry.item; next unless item %>
      <article class="profile-media-entry">
        <%= link_to item, class: 'profile-cover', aria: { label: item.title } do %>
          <% if item.respond_to?(:stored_cover_url) && item.stored_cover_url.present? %>
            <%= media_cover_image item, alt: '', loading: 'lazy', decoding: 'async' %>
          <% else %>
            <span class="profile-cover-title"><%= item.title %></span>
          <% end %>
        <% end %>
        <p class="profile-entry-type"><%= entry.item_type.titleize %><%= ' · Private review' if @profile_owner && !entry.is_public? && (entry.review.present? || entry.rating.present?) %></p>
        <h3><%= link_to item.title, item %></h3>
        <% if item.respond_to?(:release_year) && item.release_year.present? %><p class="profile-entry-year"><%= item.release_year %></p><% end %>
      </article>
    <% end %>
  </div>
  <% if items.respond_to?(:total_pages) %><div class="pagination-wrapper"><%= paginate items %></div><% end %>
<% else %>
  <div class="profile-empty"><h3><%= empty_title %></h3><p><%= empty_description %></p><%= link_to 'Explore Trove', movies_path %></div>
<% end %>
