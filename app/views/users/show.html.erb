<% content_for(:title, "#{@user.name}'s library") %>
<% content_for(:meta_description, @user.bio.presence || "Explore #{@user.name}'s public collection and recent activity on Trove.") %>
<% public_url = canonical_item_url(@user) %>
<% content_for(:canonical_url, public_url) %>
<% content_for(:og_type, 'profile') %>
<% content_for(:meta_image, url_for(@user.avatar)) if @user.avatar.attached? %>
<div class="library-profile profile-page" data-profile-accent="<%= @user.profile_accent %>" data-profile-header="<%= @user.profile_header %>">
  <% if current_user?(@user) && !@profile_owner %>
    <div class="profile-notice">You’re viewing your public profile. Private items are hidden. <%= link_to 'Back to your profile', user_path(@user) %></div>
  <% end %>
  <% if @user.header_banner.attached? %>
    <div class="library-profile-banner"><%= image_tag @user.header_banner, alt: '', class: 'banner-img' %></div>
  <% else %>
    <div class="library-profile-banner"><div class="banner-placeholder" aria-hidden="true"></div></div>
  <% end %>
  <header class="library-profile-heading">
    <%= user_avatar_tag(@user, size: 112) %>
    <div class="library-profile-identity">
      <h1><%= @user.name %>’s library</h1>
      <% if @user.display_handle.present? %><p class="library-profile-handle"><%= @user.display_handle %></p><% end %>
      <% if @user.bio.present? %><p class="library-profile-bio"><%= @user.bio %></p><% end %>
      <p class="library-profile-member">Member since <%= @user.created_at.strftime('%B %Y') %></p>
    </div>
    <div class="library-profile-actions">
      <% if @profile_owner %>
        <%= link_to 'Edit profile', settings_path, class: 'sleek-btn sleek-btn-primary' %>
        <%= link_to 'Public preview', user_path(@user, preview: 'public'), class: 'sleek-btn sleek-btn-secondary' %>
      <% elsif logged_in? && !current_user?(@user) %>
        <%= render 'follow_form', user: @user %>
      <% elsif !logged_in? %>
        <%= link_to 'Log in to follow', login_path, class: 'sleek-btn sleek-btn-primary' %>
      <% end %>
      <div class="profile-share" data-controller="link-share" data-link-share-url-value="<%= public_url %>">
        <button type="button" class="sleek-btn sleek-btn-secondary" data-action="link-share#copy">Share profile</button>
        <span role="status" aria-live="polite" data-link-share-target="status"></span>
        <input readonly hidden value="<%= public_url %>" aria-label="Public profile link" data-link-share-target="fallback">
      </div>
    </div>
  </header>
  <div class="library-profile-layout">
    <section class="library-profile-main" aria-label="Library">
      <div class="library-profile-stats">
        <%= link_to profile_tab_path('collection') do %><span>Collection</span><strong><%= @collection_count %></strong><% end %>
        <%= link_to profile_tab_path('backlog') do %><span>Backlog</span><strong><%= @backlog_count %></strong><% end %>
        <%= link_to following_user_path(@user) do %><span>Following</span><strong><%= @user.following.size %></strong><% end %>
        <%= link_to followers_user_path(@user) do %><span>Followers</span><strong><%= @user.followers.size %></strong><% end %>
      </div>
      <nav class="library-profile-tabs" aria-label="Profile sections">
        <% { 'overview' => 'Overview', 'collection' => 'Collection', 'backlog' => 'Backlog', 'posts' => 'Activity', 'likes' => 'Likes' }.each do |key, label| %>
          <%= link_to label, profile_tab_path(key), class: (@profile_tab == key ? 'active' : nil), aria: { current: @profile_tab == key ? 'page' : nil } %>
        <% end %>
      </nav>
      <% if @profile_tab == 'overview' %>
        <% if @in_progress_items.any? %>
          <section class="profile-section" id="in_progress_section">
            <div class="profile-section-heading">
              <h2>In progress</h2>
              <span><%= @in_progress_items.size %> active <%= @in_progress_items.size == 1 ? 'series' : 'series' %></span>
            </div>
            <div class="in-progress-grid">
              <% @in_progress_items.each do |item| %>
                <%= render 'shared/in_progress_card', in_progress: item, profile_owner: @profile_owner %>
              <% end %>
            </div>
          </section>
        <% end %>
        <section class="profile-section">
          <div class="profile-section-heading"><h2>Recently collected</h2><%= link_to 'View all', profile_tab_path('collection') %></div>
          <%= render 'profile_shelf', items: @recent_collection, empty_title: 'A library waiting to happen.', empty_description: @profile_owner ? 'Find something you love and add it to your collection.' : 'No public collection items yet.' %>
        </section>
        <section class="profile-section">
          <div class="profile-section-heading"><h2>Recent activity</h2><%= link_to 'View all', profile_tab_path('posts') %></div>
          <%= render 'profile_feed', feed: @combined_feed.first(5) %>
        </section>
      <% elsif %w[collection backlog].include?(@profile_tab) %>
        <section class="profile-section">
          <div class="profile-section-heading"><h2><%= @profile_tab.capitalize %></h2><span><%= @profile_owner ? 'Your library, including private items' : 'Public items only' %></span></div>
          <%= form_with url: user_path(@user), method: :get, class: 'profile-filter' do |f| %>
            <%= hidden_field_tag :tab, @profile_tab %>
            <%= hidden_field_tag :preview, 'public' if params[:preview] == 'public' %>
            <%= label_tag :type, 'Media type' %>
            <%= select_tag :type, options_for_select(ProfilesHelper::PROFILE_MEDIA_TYPES.map { |key, label| [label, key] }, params[:type]), include_blank: 'All media' %>
            <%= f.button 'Filter', class: 'btn btn-secondary' %>
          <% end %>
          <%= render 'profile_shelf', items: @profile_tab == 'collection' ? @collection_items : @backlog_items, empty_title: 'Nothing here yet.', empty_description: params[:type].present? ? 'Try another media type or choose All media.' : (@profile_owner ? 'Browse Trove to start building this shelf.' : 'No public items on this shelf yet.') %>
        </section>
      <% elsif @profile_tab == 'posts' %>
        <section class="profile-section"><div class="profile-section-heading"><h2>Activity</h2></div>
          <% if @profile_owner %>
            <%= form_with model: Post.new, class: 'profile-composer' do |f| %>
              <%= f.label :content, 'Share something with your followers' %>
              <%= f.text_area :content, placeholder: 'What have you been enjoying?', required: true, rows: 3 %>
              <p>Posts are public.</p><%= f.submit 'Post', class: 'sleek-btn sleek-btn-primary' %>
            <% end %>
          <% end %>
          <%= render 'profile_feed', feed: @combined_feed %>
        </section>
      <% else %>
        <section class="profile-section"><div class="profile-section-heading"><h2>Likes</h2></div>
          <% @likes.each do |like| %>
            <% target = like.likeable; next unless target %>
            <div class="profile-like-row">Liked a <%= like.likeable_type.titleize %>
              <% if target.respond_to?(:title) %><%= link_to target.title, target.is_a?(LibraryItem) ? target.item : target %><% end %>
            </div>
          <% end %>
          <% if @likes.empty? %><div class="profile-empty"><h3>No likes to show yet.</h3><p><%= @profile_owner ? 'Your liked items will appear here.' : 'Public library likes will appear here.' %></p></div><% end %>
        </section>
      <% end %>
    </section>
    <aside class="library-profile-sidebar">
      <h2>About this library</h2>
      <p><%= @user.bio.presence || "A collection of what #{@user.name} loves, and what’s next." %></p>
      <p class="profile-visibility"><%= @profile_owner ? 'Only you can see private items. Use Public preview to see what visitors see.' : 'You’re exploring the public side of this library.' %></p>
      <% if @profile_owner && @user.birthday.present? %><p class="profile-visibility">Birthday: <%= @user.birthday.strftime('%B %d, %Y') %> · Only shown to you</p><% end %>
      <section class="profile-mix"><h3>Library mix</h3>
        <% @library_mix.sort_by { |_, count| -count }.each do |type, count| %>
          <%= link_to profile_tab_path('collection', type: type) do %><span><%= ProfilesHelper::PROFILE_MEDIA_TYPES[type] || type.titleize %></span><strong><%= count %></strong><% end %>
        <% end %>
        <% if @library_mix.empty? %><p>No public items yet.</p><% end %>
      </section>
      <% if logged_in? && !current_user?(@user) %>
        <section class="profile-shared"><h3>In common</h3><p><%= pluralize(@shared_items.size, 'collected item') %> in both your libraries.</p>
          <% @shared_items.first(4).each do |entry| %><%= link_to entry.item.title, entry.item if entry.item %><% end %>
          <% if @shared_items.empty? %><p>Explore their collection to find your next favorite.</p><% end %>
        </section>
      <% elsif !logged_in? %>
        <section class="profile-join"><h3>Make room for your next favorite.</h3><p>Track what you love. Save what’s next. All in one place.</p><%= link_to 'Join Trove', signup_path, class: 'sleek-btn sleek-btn-primary' %><p>Already have an account? <%= link_to 'Log in', login_path %></p></section>
      <% else %>
        <%= link_to 'Explore the library', movies_path, class: 'sleek-btn sleek-btn-secondary' %>
      <% end %>
    </aside>
  </div>
</div>
