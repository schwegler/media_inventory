<section class="profile-favorites" aria-label="Favorite shelf preview">
  <div><h2>A few forever favorites.</h2><%= link_to 'Explore the full shelf', shelf_path(@user.username) %></div>
  <div class="profile-favorites-art">
    <% items.each do |item| %>
      <%= link_to item, data: { media_kind: item.class.name }, title: item.title do %>
        <% if item.stored_cover_url.present? %><%= media_cover_image item, alt: item.title, sizes: '(max-width: 580px) 30vw, 180px', width: 180, height: 270 %><% else %><span><%= item.title %></span><% end %>
      <% end %>
    <% end %>
  </div>
</section>
