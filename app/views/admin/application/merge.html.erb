<% content_for :title, "Merge #{@source_item.title}" %>
<header class="page-header"><div><%= link_to '← Back to record', [:admin, @source_item], class: 'back-link' %><h1>Merge duplicate</h1><p>Consolidate <strong><%= @source_item.title %></strong> into a retained record.</p></div></header>
<div class="admin-alert admin-alert--error">The source record will be permanently deleted. Library entries, activities, comments, likes, and edit suggestions move to the target. Episodes / issues are moved when they do not conflict. Conflicting child records block the merge so their history can be reviewed first. This cannot be undone.</div>
<%= form_with url: [:do_merge, :admin, @source_item], method: :post, class: 'admin-form', data: { turbo_confirm: "Permanently merge #{@source_item.title} into the selected target? The source will be deleted." } do |f| %><div class="field-unit"><%= f.label :target_id, 'Retained record' %><%= f.collection_select :target_id, @target_items, :id, :title, { prompt: 'Choose the record to keep' }, required: true %></div><div class="form-actions"><%= f.submit 'Merge and delete source', class: 'button button--danger', data: { turbo_submits_with: 'Merging…' } %><%= link_to 'Cancel', [:admin, @source_item], class: 'button' %></div><% end %>
