<% content_for :title, admin_label(page.resource) %>
<header class="page-header"><div><%= link_to "← #{admin_resource_title}", url_for(action: :index), class: 'back-link' %><h1 id="page-title"><%= admin_label(page.resource) %></h1><p><%= page.resource.class.model_name.human %> · updated <%= time_ago_in_words(page.resource.updated_at) %> ago</p></div><div class="actions"><%= render 'admin/application/media_actions', record: page.resource %><%= link_to 'Edit record', [:edit, namespace, page.resource], class: 'button button--primary' if accessible_action?(page.resource, :edit) %><%= button_to 'Delete', [namespace, page.resource], class: 'button button--danger', method: :delete, data: { turbo_confirm: "Delete #{admin_label(page.resource)}? Associated records may also be removed. This cannot be undone." } if accessible_action?(page.resource, :destroy) %></div></header>
<% if admin_media?(page.resource) %><%= render 'admin/application/media_summary', record: page.resource %><% end %>
<%= content_for(:before_main) %>
<% if content_for?(:main) %><%= content_for(:main) %><% else %><section class="main-content__body"><%= render 'admin/application/attributes', page: page %></section><% end %>
<%= content_for(:after_main) %>
