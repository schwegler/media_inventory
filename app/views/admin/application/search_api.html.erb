<% content_for :title, "Metadata for #{admin_label(@item)}" %>
<header class="page-header"><div><%= link_to '← Back to record', [:admin, @item], class: 'back-link' %><h1>Search metadata provider</h1><p>Find a match for <strong><%= @item.title %></strong>.</p></div></header>
<div class="admin-alert">Choose a result to fill empty metadata fields. To change an existing match or artwork, use Edit record. Saving a new metadata ID may also run the record’s automatic sync, replacing primary metadata or rebuilding episode / issue records. Review the match before applying it.</div>
<%= form_with url: [:search_api, :admin, @item], method: :get, class: 'resource-filters' do |f| %><div class="filter-search"><%= f.label :query, 'Title or search terms' %><%= f.search_field :query, value: @query, required: true %></div><%= f.submit 'Search providers', class: 'button button--primary', data: { turbo_submits_with: 'Searching…' } %><% end %>
<% if @results.any? %><h2>Provider matches</h2><div class="provider-results"><% @results.each do |result| %><article class="provider-result"><% if result[:thumbnail_url].to_s.match?(%r{\Ahttps?://}i) %><%= image_tag result[:thumbnail_url], alt: '', loading: 'lazy', data: { admin_artwork: true }, referrerpolicy: 'no-referrer' %><% end %><div><h3><%= result[:title] %></h3><p><%= result[:release_year] %></p><small><%= admin_provider_reference(result[:external_url]) %></small><dl><% %i[director artist author writer publisher network developer platform genre api_id].each do |key| %><% if result[key].present? %><dt><%= key.to_s.humanize %></dt><dd><%= result[key] %></dd><% end %><% end %></dl></div><%= form_with url: [:update_from_api, :admin, @item], method: :post do |f| %><% result.each do |key, value| %><%= f.hidden_field "api_data[#{key}]", value: value %><% end %><%= f.submit 'Fill missing metadata', class: 'button button--primary', data: { turbo_confirm: 'Apply this provider match? A new metadata ID may trigger automatic sync, replace primary metadata, or rebuild episode / issue records.', turbo_submits_with: 'Applying metadata…' } %><% end %></article><% end %></div>
<% else %><div class="empty-state"><h2>No provider matches</h2><p>Try another title and check enabled provider credentials in API configuration. Empty results may also mean a provider is unavailable.</p></div><% end %>
