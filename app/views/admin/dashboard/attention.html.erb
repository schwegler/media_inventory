<% content_for :title, 'Catalog attention' %>
<header class="page-header"><div><%= link_to '← Command Center', admin_root_path, class: 'back-link' %><h1>Catalog attention</h1><p><%= Admin::Catalog::FILTERS[@filter] %> · review metadata gaps across media types.</p></div></header>
<nav class="actions" aria-label="Catalog checks"><% Admin::Catalog::FILTERS.each do |key, label| %><%= link_to label, admin_attention_path(health: key), class: 'button', aria: { current: @filter == key ? 'page' : nil } %><% end %></nav>
<% @groups.each do |model, total, records| %><% next if total.zero? %><section class="search-results"><div class="section-header"><h2><%= model.model_name.human.pluralize %> <span class="badge"><%= number_with_delimiter(total) %></span></h2><%= link_to 'Review all →', url_for(controller: "/admin/#{model.model_name.route_key}", action: :index, health: @filter) %></div><ul class="record-list"><% records.each do |record| %><li><%= render 'admin/application/artwork', record: record %><div><%= admin_record_link(record) %><small><%= admin_media_context(record) %></small></div><%= link_to 'Edit', [:edit, :admin, record], class: 'button' %></li><% end %></ul></section><% end %>
<% if @groups.all? { |_model, total, _records| total.zero? } %><div class="empty-state"><h2>No items need attention</h2><p>No records match this catalog check.</p></div><% end %>
