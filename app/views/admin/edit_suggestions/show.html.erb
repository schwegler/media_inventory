<% suggestion = page.resource %>
<% content_for :title, 'Review edit suggestion' %>
<header class="page-header"><div><%= link_to '← Moderation queue', admin_edit_suggestions_path(status: 'pending'), class: 'back-link' %><h1>Review edit suggestion</h1><p><%= admin_record_link(suggestion.suggestable) %> · proposed by <%= admin_record_link(suggestion.user) %></p></div><span class="badge <%= suggestion.status == 'pending' ? 'badge--warning' : '' %>"><%= suggestion.status.humanize %></span></header>
<div class="review-context"><p>Submitted <%= l(suggestion.created_at, format: :long) %> · <%= time_ago_in_words(suggestion.created_at) %> ago</p><p class="muted">Compare the record’s current value with the proposed change. Highlighting marks the changed part of each proposed value.</p></div>
<div class="table-container"><table class="diff-table"><caption class="sr-only">Current and proposed metadata values</caption><thead><tr><th scope="col">Field</th><th scope="col">Current value</th><th scope="col">Proposed value</th></tr></thead><tbody><% admin_changes(suggestion).each do |key, value| %><% current = suggestion.suggestable.public_send(key) if Admin::ModerateSuggestion::ALLOWED_FIELDS.include?(key) && suggestion.suggestable.respond_to?(key) %><tr><th scope="row" data-label="Field"><%= key.humanize %></th><td data-label="Current value"><%= current.presence || 'Not set' %></td><td data-label="Proposed value"><%= admin_diff(current, value) %></td></tr><% end %></tbody></table></div>
<% if suggestion.status == 'pending' %><div class="review-actions"><%= button_to 'Approve and apply', approve_admin_edit_suggestion_path(suggestion), method: :post, class: 'button button--primary', data: { turbo_confirm: 'Approve this suggestion and apply its changes to the current record?', turbo_submits_with: 'Applying…' } %><%= button_to 'Reject suggestion', reject_admin_edit_suggestion_path(suggestion), method: :post, class: 'button button--danger', data: { turbo_confirm: 'Reject this suggestion? The contributor will be notified.', turbo_submits_with: 'Rejecting…' } %><%= link_to 'Edit notes', edit_admin_edit_suggestion_path(suggestion), class: 'button' %></div><% else %><div class="admin-alert">This suggestion was <%= suggestion.status %>. The decision is preserved in the review history.</div><% end %>
<% if suggestion.admin_notes.present? %><section class="panel"><h2>Admin notes</h2><p><%= suggestion.admin_notes %></p></section><% end %>
<%= link_to 'Next pending suggestion →', admin_edit_suggestion_path(@next_pending), class: 'button' if @next_pending %>
