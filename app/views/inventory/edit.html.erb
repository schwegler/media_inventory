<% content_for(:title, "Edit #{@resource.title}") %>
<section class="settings-content inventory-edit">
  <h1>Edit <%= @resource.title %></h1>
  <p>Update the catalog details and your library entry.</p>
  <%= form_with model: @resource, class: 'settings-form' do |f| %>
    <%= render 'shared/error_messages', object: f.object %>
    <% %w[title director artist author writer publisher developer platform network genre release_year issue_number].each do |field| %>
      <% next unless @resource.has_attribute?(field) %>
      <div class="form-group"><%= f.label field %><%= f.text_field field, class: 'form-control' %></div>
    <% end %>
    <div class="form-group"><%= f.label :cover_image, 'Custom cover' %><%= f.file_field :cover_image, accept: 'image/*', class: 'form-control' %></div>
    <div class="form-group"><%= f.label :review %><%= f.text_area :review, rows: 5, class: 'form-control' %></div>
    <div class="form-group"><%= f.label :rating %><%= f.select :rating, [['Unrated', '']] + (1..10).map { |n| ["#{n / 2.0} ★", (n / 2.0).to_s] }, {}, class: 'form-control' %></div>
    <% %w[is_collected in_watchlist consumed is_public].each do |field| %>
      <% label = { 'is_collected' => 'In collection', 'in_watchlist' => "In #{MediaLanguage.for(@resource)[:list]}", 'consumed' => MediaLanguage.for(@resource)[:past].capitalize, 'is_public' => 'Make review public' }.fetch(field) %>
      <div class="check-field"><%= f.check_box field %><%= f.label field, label %></div>
    <% end %>
    <div class="form-actions"><%= f.submit 'Save changes', class: 'btn btn-primary' %><%= link_to 'Cancel', @resource, class: 'btn btn-secondary' %></div>
  <% end %>
</section>
