<%= turbo_stream.replace "media_actions_video_game_#{@resource.id}" do %>
  <%= render 'shared/media_actions_and_stream', item: @resource, show_sources: false %>
<% end %>

<%= turbo_stream.replace "my-game-tracking" do %>
  <%= render 'video_games/tracking', library: @library_item %>
<% end %>

<%= turbo_stream.replace "flash-messages" do %>
  <div id="flash-messages">
    <% flash.each do |message_type, message| %>
      <% next if message_type.to_s == "metadata_result" %>
      <div class="alert alert-<%= message_type %>" data-controller="flash" data-flash-dismiss-after-value="0" role="status" aria-live="polite">
        <span><%= message %></span>
        <button type="button" class="btn-unstyled flash-dismiss" data-action="flash#dismiss" aria-label="Dismiss message">×</button>
      </div>
    <% end %>
  </div>
<% end %>

<% if @open_copy_modal && @copy %>
  <%= turbo_stream.update "modal" do %>
    <div class="modal-overlay" data-controller="modal" data-modal-target="overlay" data-action="click->modal#closeOnBackdrop keydown@window->modal#closeOnEsc">
      <div class="modal-container" role="dialog" aria-modal="true">
        <div class="modal-header">
          <h2><%= tracking_modal_title('copy', :edit) %></h2>
          <button class="modal-close" data-action="click->modal#close" aria-label="Close modal">&times;</button>
        </div>
        <div class="modal-body">
          <%= render 'game_tracking/form', library: @library_item, kind: 'copy', record: @copy %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
