<header class="game-section-heading">
  <div>
    <h3>My completion milestones</h3>
    <p>Manual goals and personal achievements.</p>
  </div>
  <div class="game-heading-actions">
    <span class="game-count"><%= library.game_milestones.size %></span>
    <%= link_to 'Add milestone', new_game_tracking_path(video_game_id: library.item_id, kind: 'milestone'), class: 'btn btn-secondary btn-sm', data: { turbo_frame: 'modal' } %>
  </div>
</header>

<% milestones = library.game_milestones.order(:created_at) %>
<% if milestones.any? %>
  <p class="game-milestone-tally"><%= milestones.where.not(completed_at: nil).count %> / <%= milestones.count %> completed. These are your manual goals, separate from platform achievements.</p>
  <div class="game-items-list">
    <% milestones.each do |milestone| %>
      <div class="game-item-entry">
        <div class="game-item-content">
          <p class="game-item-main">
            <strong><%= milestone.spoiler? ? 'Spoiler milestone' : milestone.title %></strong> ·
            <span class="game-pill <%= milestone.completed_at ? 'game-pill-success' : '' %>"><%= milestone.completed_at ? 'Completed' : 'Planned' %></span>
          </p>
          <% if milestone.description.present? %><p class="game-item-desc"><%= milestone.description %></p><% end %>
        </div>
        <%= link_to 'Edit', edit_game_tracking_path(video_game_id: library.item_id, id: milestone.id, kind: 'milestone'), class: 'btn btn-secondary btn-sm', data: { turbo_frame: 'modal' }, aria: { label: "Edit milestone #{milestone.title}" } %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="game-empty-hint">No milestones recorded yet.</p>
<% end %>
