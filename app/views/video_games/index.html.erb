<% content_for(:media_workspace, "true") %>
<section class="catalog-page collection-page">
<div class="catalog-heading">
  <div><h1><%= @personal_library ? 'My game library' : 'Video Games' %></h1><% if @personal_library %><p class="library-description">Your games, your next adventure.</p><% end %></div>
  <% if logged_in? %>
    <%= link_to 'Log a game', new_video_game_path, class: 'sleek-btn sleek-btn-primary' %>
  <% end %>
</div>
<%= render 'shared/library_switch', klass: VideoGame %>
<% if @personal_library %>
  <section class="library-overview" aria-label="Your library at a glance">
    <% [['Games', :unique_games, {}], ['Playing', :currently_playing, { play_status: 'playing' }], ['Backlog', :backlog, { play_status: 'backlog' }], ['Completed', :completed, { play_status: 'completed' }]].each do |label, key, filters| %>
      <%= link_to library_link(VideoGame, { play_status: nil, ownership_status: nil, favorite: nil }.merge(filters)), class: 'library-metric' do %>
        <strong><%= @game_statistics[key] %></strong><span><%= label %></span>
      <% end %>
    <% end %>
  </section>
  <nav class="library-shelves" aria-label="Library shelves">
    <% [['All games', {}], ['Playing', { play_status: 'playing' }], ['Backlog', { play_status: 'backlog' }], ['Completed', { play_status: 'completed' }], ['Wishlist', { ownership_status: 'wishlist' }], ['Favorites', { favorite: '1' }]].each do |label, filters| %>
      <% active = @filters.slice('play_status', 'ownership_status', 'favorite') == filters.stringify_keys %>
      <%= link_to label, library_link(VideoGame, { play_status: nil, ownership_status: nil, favorite: nil }.merge(filters)), aria: { current: active ? 'page' : nil } %>
    <% end %>
  </nav>
<% end %>
<%= render 'library_filters' %>
<div class="collection-utilities">
<div class="collection-results-bar">
  <p role="status"><%= number_with_delimiter(@video_games.total_count) %> <%= 'game'.pluralize(@video_games.total_count) %></p>
  <% if @filters.any? %><%= link_to 'Reset filters', video_games_path(library: @personal_library ? 'mine' : nil) %><% end %>
</div>
<% if @personal_library %>
  <details class="collection-tools"><summary>Library tools &amp; saved views</summary>
    <nav class="library-saved-views" aria-label="Saved collection views">
      <%= link_to 'My Shelf', my_shelf_path %>
      <% @saved_views.each do |view| %><%= link_to view.name, video_games_path(library: 'mine', view: view.id), aria: { current: @saved_view == view ? 'page' : nil } %><% end %>
    </nav>

  <details class="game-library-disclosure"><summary>Save this collection view</summary>
    <%= form_with url: game_library_views_path, class: 'standard-form', namespace: 'save_view' do |f| %>
      <%= f.label :name, 'View name' %><%= f.text_field :name, required: true, maxlength: 60 %>
      <% @filters.each do |key, value| %><%= hidden_field_tag "filters[#{key}]", value, id: nil %><% end %>
      <%= f.submit 'Save view', class: 'btn btn-secondary' %>
    <% end %>
    <% if @saved_view %>
      <%= button_to "Delete saved view: #{@saved_view.name}", game_library_view_path(@saved_view), method: :delete, class: 'btn btn-secondary' %>
    <% end %>
  </details>
  <%= render 'library_imports' %>
    <%= render 'library_statistics' %>
  </details>
<% end %>
</div>
<% if @video_games.empty? %>
  <div class="home-empty-state mascot-empty-card" role="status">
    <div class="empty-state-mascot" aria-hidden="true">
      <%= image_tag 'brand/facet_pose_02_gamer_mode.png', class: 'mascot-sticker mascot-slot-empty', width: 90, height: 171, alt: '' %>
    </div>
    <h2>0 matches in the vault</h2>
    <p>No games match this view. Even Facet checked the back of the cartridge shelf and came up empty.</p>
    <div class="empty-state-actions">
      <%= link_to 'Clear filters', video_games_path(library: @personal_library ? 'mine' : 'all'), class: 'sleek-btn sleek-btn-secondary' %>
      <%= link_to 'Log a game', new_video_game_path, class: 'sleek-btn sleek-btn-primary' %>
    </div>
  </div>
<% elsif @layout == 'table' %>
  <%= render 'library_table' %>
<% else %>
  <div class="<%= @layout == 'list' ? 'game-library-list' : 'media-grid-2026 catalog-grid' %>">
    <% @video_games.each do |game| %>
      <%= render 'library_card', game: game, library: @libraries&.[](game.id) %>
    <% end %>
  </div>
<% end %>
<div class="pagination-wrapper"><%= paginate @video_games %></div>
</section>
