<%
  backdrop_url = @library_item&.game_cover_image&.attached? ? rails_storage_proxy_path(@library_item.game_cover_image) : @video_game.stored_cover_url
  hero_art = @artworks.find { |art| art.kind == 'hero' && art.image.attached? } || @artworks.find { |art| art.kind == 'background' && art.image.attached? }
  hero_url = hero_art ? rails_storage_proxy_path(hero_art.image) : backdrop_url
%>
<% content_for(:title, @video_game.title) %>
<% content_for(:meta_description, "Video Game by #{@video_game.developer || 'Unknown Developer'} • #{@video_game.platform} • #{@video_game.release_year}") %>
<% content_for(:meta_image, backdrop_url) if backdrop_url.present? %>

<% content_for(:item_detail, 'true') %>
<% content_for(:header_artwork, hero_url) if hero_url.present? %>

<div class="show-hero">
  <% if hero_url %>
    <img class="show-hero-backdrop" src="<%= hero_url %>" alt="" />
  <% end %>
  <div class="show-hero-gradient"></div>
</div>

<div class="show-container container">
  <!-- Left Column: Poster and Quick Actions -->
  <div class="show-left">
    <div class="show-poster-card">
      <div class="show-poster">
        <% if backdrop_url.present? %>
          <%= game_library_image(@video_game, @library_item, alt: "#{@video_game.title} Cover", class: "game-cover-art", sizes: "230px") %>
            <% else %>
          <div class="poster-fallback"><span class="fallback-emoji">🎮</span></div>
        <% end %>
      </div>
      
      <div class="poster-stats">
        <% stats = community_stats_for(@video_game) %>
        <span class="stat-item" title="Watchers"><span class="stat-icon">👁</span> <%= stats[:watchers].size %></span>
        <span class="stat-item" title="Collectors"><span class="stat-icon">📁</span> <%= stats[:collectors].size %></span>
        <span class="stat-item" title="Likes"><span class="stat-icon">♥</span> <%= @video_game.likes.size %></span>
      </div>
    </div>

  </div>

  <!-- Right Column: Title, Metadata, Reviews -->
  <div class="show-right">
    <div class="show-header-details">
      <%= render "shared/item_sharing", item: @video_game %>
      <h1 class="show-title"><%= @video_game.title %></h1>
      <p class="show-meta-subtitle">
        Developed by <span class="meta-highlight"><%= @video_game.developer || 'Unknown Developer' %></span> &bull; <%= @video_game.platform %> &bull; <%= @video_game.release_year %>
      </p>
      
      <div class="show-rating-container" style="display: flex; align-items: center; gap: 10px;">
        <% if @video_game.rating.present? %>
          <div class="show-rating"><%= render_stars(@video_game.rating) %></div>
        <% end %>
        <% if stats[:avg_rating] %>
          <div class="show-avg-rating" style="color: var(--text-secondary); font-size: 0.9em; font-weight: 500;">
            <%= stats[:avg_rating] %> ★ avg
          </div>
        <% end %>
      </div>
    </div>

    <% if @video_game.synopsis.present? %><div class="show-community"><h2>About this game</h2><%= simple_format(@video_game.synopsis) %></div><% end %>
    <% if @video_game.metadata_details.present? %><dl class="show-community">
      <% { 'genres' => 'Genres', 'features' => 'Features', 'languages' => 'Languages', 'controller_support' => 'Controller support' }.each do |key, label| %>
        <% value = @video_game.metadata_details[key] %><% next if value.blank? %><dt><%= label %></dt><dd><%= value.is_a?(Array) ? value.join(', ') : value %></dd>
      <% end %>
    </dl><% end %>
    <%= render 'shared/media_actions_and_stream' , item: @video_game %>
    <%= render 'shared/metadata_refresh', item: @video_game %>
    <div class="game-source-credits">
      <% if @video_game.external_url.to_s.start_with?('https://') %><p>Metadata: <%= link_to(@video_game.api_id.to_s.start_with?('rawg_') ? 'RAWG' : 'Provider source', @video_game.external_url, rel: 'noopener noreferrer') %></p><% end %>
      <% artwork_blob = @library_item&.game_cover_image&.attached? ? @library_item.game_cover_image.blob : (@video_game.cover_image.blob if @video_game.cover_image.attached?) %>
      <% if artwork_blob %><% MediaArtworkSource.where(blob_id: artwork_blob.id).each do |source| %>
        <% provenance = source.provenance || {} %><% next if provenance['provider'].blank? %>
        <p>Artwork: <%= provenance['provider'] %><%= " · #{provenance['author']}" if provenance['author'].present? %>
        <% if provenance['attribution_url'].to_s.start_with?('https://') %> · <%= link_to 'Artwork source', provenance['attribution_url'], rel: 'noopener noreferrer' %><% end %></p>
      <% end %><% end %>
    </div>
    <%= render 'artwork_gallery', game: @video_game, library: @library_item %>
    <%= render 'tracking', library: @library_item if @library_item %>

    <% if @video_game.review.present? %>
      <div class="show-review">
        <h3>My Review</h3>
        <blockquote><%= simple_format(@video_game.review) %></blockquote>
      </div>
    <% end %>

    <div class="show-community">
      <h2>Community</h2>

      <div class="show-stats-bar">
        <div class="show-stat">
          <div class="show-stat-value"><%= stats[:avg_rating] ? "#{stats[:avg_rating]} ★" : "—" %></div>
          <div class="show-stat-label">Average Rating</div>
        </div>
        <div class="show-stat">
          <div class="show-stat-value"><%= stats[:watchers].size %></div>
          <div class="show-stat-label">Players</div>
        </div>
        <div class="show-stat">
          <div class="show-stat-value"><%= stats[:collectors].size %></div>
          <div class="show-stat-label">Collectors</div>
        </div>
      </div>

      <% if stats[:reviews].any? %>
        <h3>Community Reviews</h3>
        <div class="show-reviews-list">
          <% stats[:reviews].each do |matching_item| %>
            <div class="show-review-card">
              <div class="review-header">
                <%= user_avatar_tag(matching_item.user, size: 28) %>
                <div class="review-meta-info">
                  <span class="review-user"><%= matching_item.user.name.presence || matching_item.user.display_handle %></span>
                  <% if matching_item.rating.present? %>
                    <span class="review-rating"><%= render_stars(matching_item.rating) %></span>
                  <% end %>
                </div>
              </div>
              <div class="review-content"><%= simple_format(matching_item.review) %></div>
              
              <div class="review-actions-row">
                <%= render 'likes/like_button', item: matching_item %>
              </div>

              <%= render 'shared/comments_box', matching_item: matching_item %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if stats[:watchers].any? %>
        <h3>Players</h3>
        <div class="show-members-list">
          <% stats[:watchers].each do |user| %>
            <span class="show-member-tag"><%= user_avatar_tag(user, size: 20) %> <%= user.name.presence || user.display_handle %></span>
          <% end %>
        </div>
      <% end %>

      <% if stats[:collectors].any? %>
        <h3>Collectors</h3>
        <div class="show-members-list">
          <% stats[:collectors].each do |user| %>
            <span class="show-member-tag"><%= user_avatar_tag(user, size: 20) %> <%= user.name.presence || user.display_handle %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    
    <div class="show-community" style="margin-top: 2rem;">
      <h3>General Comments</h3>
      <%= render "shared/comments_box", matching_item: @video_game %>
    </div>
    <div class="show-actions">
      <%= link_to '← Back to Video Games', video_games_path, class: 'btn btn-secondary' %>
    </div>
  </div>
</div>
