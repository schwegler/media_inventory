<div class="game-field"><%= f.label :started_at, 'Started (application time zone)' %><%= f.datetime_local_field :started_at, value: session&.started_at&.strftime('%Y-%m-%dT%H:%M'), required: true %></div>
<div class="game-field"><%= f.label :ended_at, 'Ended (application time zone)' %><%= f.datetime_local_field :ended_at, value: session&.ended_at&.strftime('%Y-%m-%dT%H:%M'), required: true %></div>
<div class="game-field game-field-wide"><%= f.label :notes %><%= f.text_area :notes, value: session&.notes %></div>
<div class="game-field game-field-wide"><%= f.label :milestones, 'Session milestones or achievements earned (manual notes)' %><%= f.text_area :milestones, value: session&.milestones %></div>
<details><summary>Progress and enjoyment</summary><div class="game-nested-fields">
  <div class="game-field"><%= f.label :progress, 'Progress at end (%)' %><%= f.number_field :progress, value: session&.progress, min: 0, max: 100 %></div>
  <div class="game-field"><%= f.label :enjoyment, 'Enjoyment (1–5)' %><%= f.number_field :enjoyment, value: session&.enjoyment, min: 1, max: 5 %></div>
  <div class="game-field"><%= f.label :mood %><%= f.text_field :mood, value: session&.mood, maxlength: 80 %></div>
</div></details>
