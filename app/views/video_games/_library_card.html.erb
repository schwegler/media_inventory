<% ratings = item_card_ratings(game, user_library: library) %>
<% user_rating = ratings[:user_rating] %>
<% avg_rating = ratings[:avg_rating] %>
<article class="card-2026 game-library-card">
  <div class="card-2026-cover">
    <%= game_library_image(game, library, alt: "#{game.title} cover", loading: 'lazy', decoding: 'async') %>
  </div>
  <div class="card-2026-content">
    <h2 class="card-2026-title"><%= link_to game.title, game %></h2>
    <p class="card-2026-meta"><%= [game.release_year, game.game_type.humanize, game.developer.presence].compact.join(' · ') %></p>
    <% if library %>
      <p class="game-library-status"><%= library.game_playthroughs.map { |run| run.status.humanize }.uniq.join(' · ').presence || 'No playthrough recorded' %></p>
      <p class="card-2026-meta"><%= library.game_copies.map { |copy| "#{copy.platform} (#{copy.ownership_status.humanize.downcase})" }.uniq.join(' · ').presence || 'No explicit copy records' %></p>
      <p class="card-2026-meta">Recorded: <%= game_playtime(game[:recorded_minutes]) %></p>
    <% end %>
    <% if user_rating.present? || avg_rating.present? %>
      <div class="card-2026-ratings">
        <% if user_rating.present? %>
          <span class="card-2026-user-rating" title="Your rating: <%= user_rating %> / 5">
            <span class="rating-label">Your rating:</span>
            <span class="rating-stars"><%= render_stars(user_rating) %></span>
          </span>
        <% end %>
        <% if avg_rating.present? %>
          <span class="card-2026-avg-rating" title="Average rating: <%= avg_rating %> / 5">
            <span class="rating-label">Avg rating:</span>
            <span class="rating-value"><%= avg_rating %> ★</span>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
</article>
