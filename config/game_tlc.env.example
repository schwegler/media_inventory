# Add these settings to the existing deployment environment; this file is not auto-loaded.
GAME_METADATA_PROVIDER_PRIORITY=Steam,RAWG,Wikipedia
GAME_ARTWORK_PROVIDER_PRIORITY=SteamGridDB,Steam,RAWG,Wikipedia
GAME_PROVIDER_REQUESTS_PER_MINUTE=60
GAME_STEAM_REQUESTS_PER_MINUTE=60
GAME_RAWG_REQUESTS_PER_MINUTE=30
GAME_STEAMGRIDDB_REQUESTS_PER_MINUTE=30
MEDIA_ARTWORK_QUOTA_MB=512
MEDIA_ARTWORK_QUEUE_LIMIT=100
# Configure credentials through Admin > API configurations, not this example.
# RAWG: source_name=RAWG, media_type=VideoGame, is_active=true, access_token=<key>
# SteamWebAPI: source_name=SteamWebAPI, media_type=VideoGame, is_active=true, access_token=<key>
# SteamGridDB: source_name=SteamGridDB, media_type=VideoGame, is_active=true, access_token=<key>
# SteamGridDB options JSON: {"allow_image_storage":true}
# The storage flag asserts that the operator has reviewed applicable artwork rights.
